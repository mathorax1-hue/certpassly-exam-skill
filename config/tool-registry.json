{
  "schema_version": 1,
  "canonical_repository": "mathorax1-hue/certpassly-exam-skill",
  "visibility": "public",
  "rules": {
    "all_public_tests_synthetic": true,
    "no_owner_pdf_key_or_screenshot": true,
    "real_evidence_private_only": true,
    "no_auto_promotion": true,
    "independent_reviewer_required": true
  },
  "tools": [
    {
      "id": "artifact_tree_unpack",
      "path": "scripts/unpack_artifact_tree.py",
      "test": "tests/test_unpack_artifact_tree.py",
      "command": "python scripts/unpack_artifact_tree.py",
      "dependencies": "stdlib",
      "side_effects": "local directories and SHA manifest",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "conversation_history_append",
      "path": "scripts/append_conversation_history.py",
      "test": "tests/test_append_conversation_history.py",
      "command": "python scripts/append_conversation_history.py --private-master PRIVATE/master.json --event-batch PRIVATE/new-events.json [--apply]",
      "dependencies": "Python >=3.11 standard library only",
      "side_effects": "Preview by default; --apply atomically updates the ONE existing private master JSON in place; no network or public upload",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "environment_doctor",
      "path": "src/certpassly/doctor.py",
      "test": "tests/test_cli.py",
      "command": "CLI doctor",
      "dependencies": "stdlib",
      "side_effects": "none",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "evidence_bank_structural",
      "path": "src/certpassly/evidence.py",
      "test": "tests/test_evidence.py",
      "command": "CLI verify-evidence",
      "dependencies": "stdlib",
      "side_effects": "read-only",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "external_source_checkout",
      "path": "scripts/bootstrap_upstream.sh",
      "test": "tests/test_upstream.py",
      "command": "bash scripts/bootstrap_upstream.sh",
      "dependencies": "git; bash; HTTPS network",
      "side_effects": "ignored vendor checkout",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "ledger_preflight",
      "path": "scripts/audit_question_evidence.py",
      "test": "tests/test_audit_question_evidence.py",
      "command": "python scripts/audit_question_evidence.py",
      "dependencies": "stdlib",
      "side_effects": "read-only; optional private report",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "mcp_diagnostics",
      "path": "src/certpassly/mcp_server.py",
      "test": "tests/test_cli.py",
      "command": "certpassly-mcp",
      "dependencies": "optional mcp",
      "side_effects": "read-only",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "official_source_capture",
      "path": "scripts/capture_official_source.py",
      "test": "tests/test_capture_official_source.py",
      "command": "python scripts/capture_official_source.py",
      "dependencies": "stdlib; HTTPS network or offline file",
      "side_effects": "private evidence snapshot",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "option_and_matrix_review",
      "path": "scripts/audit_option_evidence.py",
      "test": "tests/test_audit_option_evidence.py",
      "command": "python scripts/audit_option_evidence.py",
      "dependencies": "stdlib",
      "side_effects": "read-only; optional private report",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "pinned_upstream_adapter",
      "path": "src/certpassly/upstream.py",
      "test": "tests/test_upstream.py",
      "command": "CLI upstream-run",
      "dependencies": "git, python3",
      "side_effects": "private work may be read",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "public_file_safety",
      "path": "scripts/check_public_safety.py",
      "test": "tests/test_cli.py",
      "command": "python scripts/check_public_safety.py",
      "dependencies": "stdlib; git",
      "side_effects": "read-only tracked files",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "resumable_pipeline",
      "path": "src/certpassly/pipeline.py",
      "test": "tests/test_pipeline.py",
      "command": "CLI run/status",
      "dependencies": "stdlib",
      "side_effects": "local checkpoints",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "saved_source_receipt_verifier",
      "path": "scripts/verify_saved_receipts.py",
      "test": "tests/test_verify_saved_receipts.py",
      "command": "python scripts/verify_saved_receipts.py --private-dir PRIVATE/pages/ --allow-host learn.microsoft.com",
      "dependencies": "stdlib; imports capture_official_source helper",
      "side_effects": "read-only; optional private report",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "tool_registry_validator",
      "path": "scripts/verify_tool_registry.py",
      "test": "tests/test_tool_registry.py",
      "command": "python scripts/verify_tool_registry.py",
      "dependencies": "stdlib",
      "side_effects": "read-only public registry audit",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "visual_role_reconciliation",
      "path": "scripts/reconcile_visual_roles.py",
      "test": "tests/test_reconcile_visual_roles.py",
      "command": "python scripts/reconcile_visual_roles.py --input PRIVATE/image-roles.json",
      "dependencies": "stdlib",
      "side_effects": "read-only; optional private report",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "research_worklist",
      "path": "scripts/build_research_worklist.py",
      "test": "tests/test_research_worklist.py",
      "command": "python scripts/build_research_worklist.py --exam CODE --export-dir PRIVATE/export --output PRIVATE/research-worklist.json",
      "dependencies": "Python >=3.11 standard library only",
      "side_effects": "Writes a private worklist JSON; no network and no AI",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "content_gate",
      "path": "scripts/check_content_gate.py",
      "test": "tests/test_content_gate.py",
      "command": "python scripts/check_content_gate.py --site-file PRIVATE/CODE.site-format.v2.json --output PRIVATE/content-gate.json",
      "dependencies": "Python >=3.11 standard library only",
      "side_effects": "Writes a private content-gate JSON; nonzero exit when blocked",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "prepare_exam_workspace",
      "path": "scripts/prepare_exam_workspace.py",
      "test": "tests/test_prepare_exam_workspace.py",
      "command": "python scripts/prepare_exam_workspace.py --raw-dir PRIVATE/exams/CODE --workspace PRIVATE/work --exam CODE",
      "dependencies": "Python >=3.11 standard library only",
      "side_effects": "Copies a verified owner PDF into a private workspace and writes catalog plus rights config",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "promote_ready_exam",
      "path": "scripts/promote_ready_exam.py",
      "test": "tests/test_promote_ready_exam.py",
      "command": "python scripts/promote_ready_exam.py --exam CODE --site-file PRIVATE/CODE.site-format.v2.json --ready-root PRIVATE/ready-exams --raw-commit SHA --output PRIVATE/promotion.json",
      "dependencies": "Python >=3.11 standard library only",
      "side_effects": "Copies a fully gated draft into a private ready-exams checkout only when --promote is set and every gate passes; never publishes",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "site_import_gate",
      "path": "scripts/run_site_import_gate.py",
      "test": "tests/test_site_import_gate.py",
      "command": "python scripts/run_site_import_gate.py --sandbox PRIVATE/import-sandbox --site-file PRIVATE/CODE.site-format.v2.json --output PRIVATE/import-gate.json",
      "dependencies": "Python >=3.11, php, a throwaway site sandbox on sqlite (never port 3306)",
      "side_effects": "Imports drafts into a throwaway sandbox database only; refuses production, 3306 and 8330",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "three_phase_runner",
      "path": "scripts/run_three_phase.py",
      "test": "tests/test_three_phase_pin.py",
      "command": "python scripts/run_three_phase.py --exam CODE --workspace PRIVATE/work --upstream vendor/certpassly-exam-pipeline",
      "dependencies": "Pinned upstream v1.3.1 checkout plus the tools above",
      "side_effects": "Runs technical stages in a private workspace, writes phase reports, promotes only when all gates pass and --promote is set",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    },
    {
      "id": "map_exam_domains",
      "path": "scripts/map_exam_domains.py",
      "test": "tests/test_map_exam_domains.py",
      "command": "python scripts/map_exam_domains.py --site-file PRIVATE/exam.site-format.v2.json --raw-dir PRIVATE/exams/CODE --output PRIVATE/domain-mapping.json",
      "dependencies": "Python >=3.11 standard library only",
      "side_effects": "Writes a domain mapping report; updates the site file only when an official domain list with URL, sha256 and quote is already saved; never guesses silently; no network and no AI",
      "owner": "CertPassly Team",
      "scope": "shared",
      "release_authority": false
    }
  ]
}
