+def _is_fragment_word(word, neighbours, source_tokens, min_word):
+    """True when an OCR word is not a real word, so the confidence gate must not count it.
+
+    A word is a fragment only when it has no letter or digit token at all
+    (pure punctuation or glyphs), or when every token in it is a strict
+    substring of a token of an adjacent word that passed the word confidence
+    threshold. A real one or two letter word that appears in the PDF text is
+    never a fragment; without the PDF token set a short token is never
+    dropped on the substring rule.
+    """
+    text = (word or {}).get('text') or ''
+    toks = tokenize(text)
+    if not toks:
+        return True
+    for tok in toks:
+        if len(tok) <= 2 and (source_tokens is None or tok in source_tokens):
+            return False
+    for neighbour in neighbours or []:
+        if not isinstance(neighbour, dict):
+            continue
+        conf = _word_conf(neighbour)
+        if conf is None or conf < min_word:
+            continue
+        neighbour_toks = tokenize(neighbour.get('text') or '')
+        if not neighbour_toks:
+            continue
+        if all(any(tok != other and tok in other for other in neighbour_toks) for tok in toks):
+            return True
+    return False
+
+
+def _kept_ocr_words(words, source_tokens, min_word):
+    """OCR words that count in the confidence gate, with fragments removed."""
+    kept = []
+    for i, w in enumerate(words or []):
+        if not isinstance(w, dict):
+            continue
+        neighbours = []
+        if i > 0:
+            neighbours.append(words[i - 1])
+        if i + 1 < len(words):
+            neighbours.append(words[i + 1])
+        if _is_fragment_word(w, neighbours, source_tokens, min_word):
+            continue
+        kept.append(w)
+    return kept
+
+
