+def _headers_dict(headers):
+    if not headers:
+        return {}
+    try:
+        items = headers.items()
+    except AttributeError:
+        try:
+            items = dict(headers).items()
+        except Exception:
+            return {}
+    out = {}
+    for key, value in items:
+        out[str(key)] = value if isinstance(value, str) else str(value)
+    return out
+
+
+def unpack_post_result(result):
+    """Accept (status, body) or (status, body, headers)."""
+    if not isinstance(result, tuple) or len(result) < 2:
+        raise TypeError('provider post() must return a status and body')
+    status, body = result[0], result[1]
+    headers = result[2] if len(result) >= 3 and result[2] is not None else {}
+    if not isinstance(headers, dict):
+        headers = _headers_dict(headers)
+    return int(status), body, headers
+
+
+def _header(headers, *names):
+    if not headers:
+        return None
+    lower = {str(k).lower(): v for k, v in headers.items()}
+    for name in names:
+        if name.lower() in lower:
+            val = lower[name.lower()]
+            if val is None or val == '':
+                continue
+            return str(val).strip()
+    return None
+
+
+def _parse_seconds_token(raw, now=None):
+    """Parse Retry-After, reset headers, or a short duration like 6s or 1m5s."""
+    import re
+    from email.utils import parsedate_to_datetime
+    if raw is None:
+        return None
+    text = str(raw).strip()
+    if not text:
+        return None
+    # HTTP-date
+    try:
+        dt = parsedate_to_datetime(text)
+        if dt is not None:
+            stamp = dt.timestamp()
+            base = time.time() if now is None else now
+            return max(0.0, stamp - base)
+    except (TypeError, ValueError, OverflowError):
+        pass
+    m = re.fullmatch(r'(?:(\d+)h)?\s*(?:(\d+)m)?\s*(?:(\d+(?:\.\d+)?)s)?', text, re.I)
+    if m and any(m.groups()):
+        hours = float(m.group(1) or 0)
+        mins = float(m.group(2) or 0)
+        secs = float(m.group(3) or 0)
+        return hours * 3600 + mins * 60 + secs
+    try:
+        val = float(text)
+    except (TypeError, ValueError):
+        return None
+    # Large values are unix timestamps.
+    if val > 1000000000:
+        base = time.time() if now is None else now
+        return max(0.0, val - base)
+    return max(0.0, val)
+
+
+def parse_retry_wait_seconds(status, body, headers=None, max_wait=65.0, now=None):
+    """Seconds to wait after HTTP 429. Prefers Retry-After, then reset-tokens, then the message."""
+    import re
+    try:
+        code = int(status)
+    except (TypeError, ValueError):
+        return None
+    if code != 429:
+        return None
+    cap = _as_float(max_wait, 65.0)
+    if cap < 0:
+        cap = 0.0
+    raw = _header(headers, 'Retry-After', 'retry-after')
+    wait = _parse_seconds_token(raw, now=now) if raw else None
+    if wait is None:
+        raw = _header(headers, 'x-ratelimit-reset-tokens')
+        wait = _parse_seconds_token(raw, now=now) if raw else None
+    if wait is None and isinstance(body, dict):
+        err = body.get('error') or {}
+        msg = err.get('message') if isinstance(err, dict) else err
+        msg = str(msg or '')
+        m = re.search(r'try again in\s+((?:\d+\s*h)?\s*(?:\d+\s*m)?\s*(?:\d+(?:\.\d+)?)\s*s?)', msg, re.I)
+        if m:
+            wait = _parse_seconds_token(m.group(1).strip(), now=now)
+    if wait is None:
+        return None
+    return min(cap, max(0.0, wait))
+
+
+def estimate_input_tokens(payload, image_count, tokens_per_image=1200):
+    """Estimate prompt tokens without counting base64 image bytes."""
+    per = _as_int(tokens_per_image, 1200)
+    if per < 0:
+        per = 0
+    text_chars = 0
+    for msg in (payload or {}).get('messages') or []:
+        if not isinstance(msg, dict):
+            continue
+        content = msg.get('content')
+        if isinstance(content, str):
+            text_chars += len(content)
+            continue
+        for part in content or []:
+            if isinstance(part, dict) and part.get('type') == 'text':
+                text_chars += len(part.get('text') or '')
+    text_tokens = max(1, (text_chars + 3) // 4)
+    return text_tokens + per * max(0, int(image_count or 0))
+
+
+def prompt_tokens_from_body(body):
+    if not isinstance(body, dict):
+        return None
+    usage = body.get('usage') or {}
+    if not isinstance(usage, dict) or usage.get('prompt_tokens') is None:
+        return None
+    try:
+        return int(usage.get('prompt_tokens'))
+    except (TypeError, ValueError):
+        return None
+
+
+class TokenPace:
+    """Pace Groq calls so estimated input tokens stay under a per-minute budget."""
+
+    def __init__(self, budget_per_minute=6000, max_wait_seconds=65.0, window_seconds=60.0, sleeper=None, clock=None):
+        self.budget = max(0, _as_int(budget_per_minute, 6000))
+        self.max_wait_seconds = max(0.0, _as_float(max_wait_seconds, 65.0))
+        self.window_seconds = max(1.0, _as_float(window_seconds, 60.0))
+        self.sleeper = sleeper or time.sleep
+        self.clock = clock or time.time
+        self.events = []
+        self.pace_waits = 0
+        self.pace_wait_ms = 0
+
+    def _prune(self, now):
+        cutoff = now - self.window_seconds
+        self.events = [(ts, tok) for ts, tok in self.events if ts > cutoff]
+
+    def before_call(self, estimated_tokens):
+        tokens = max(0, int(estimated_tokens or 0))
+        if self.budget <= 0 or tokens <= 0:
+            return 0.0
+        now = self.clock()
+        self._prune(now)
+        used = sum(tok for _ts, tok in self.events)
+        # A single call may itself exceed the budget; still send it.
+        if used == 0 or used + tokens <= self.budget:
+            return 0.0
+        need = used + tokens - self.budget
+        freed = 0
+        wait = self.window_seconds
+        for ts, tok in self.events:
+            freed += tok
+            if freed >= need:
+                wait = max(0.0, self.window_seconds - (now - ts))
+                break
+        wait = min(wait, self.max_wait_seconds)
+        if wait > 0:
+            self.sleeper(wait)
+            self.pace_waits += 1
+            self.pace_wait_ms += int(wait * 1000)
+            self._prune(self.clock())
+        return wait
+
+    def record(self, tokens):
+        try:
+            amount = int(tokens or 0)
+        except (TypeError, ValueError):
+            amount = 0
+        if amount > 0:
+            self.events.append((self.clock(), amount))
 
 
