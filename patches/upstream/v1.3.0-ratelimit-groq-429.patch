+        self.assertEqual(slept, [50.0])
+        self.assertEqual(pace.pace_waits, 1)
+        self.assertGreaterEqual(pace.pace_wait_ms, 50000)
+
+        # Shared pacer across two items: first records 900 tokens, second must wait.
