+def _agreed_ocr_tokens(ocr_item, cfg):
+    """Tokens every OCR pass of an image read: the words both passes agree on.
+
+    An image with fewer than two passes has no second read to agree with,
+    so its words count as read.
+    """
+    out = set()
+    for im in (ocr_item or {}).get('images') or []:
+        passes = im.get('passes') or {}
+        if len(passes) >= 2:
+            sets = [token_set((p.get('text') if isinstance(p, dict) else '') or '', cfg)
+                    for p in passes.values()]
+            agreed = sets[0]
+            for s in sets[1:]:
+                agreed &= s
+            out |= agreed
+        else:
+            out |= token_set(ocr_words_text({'images': [im]}), cfg)
+    return out
+
