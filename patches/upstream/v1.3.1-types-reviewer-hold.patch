             if item.get('_structure_hold'):
                 hold['reason'] = item['_structure_hold'] + '; ' + hold['reason']
                 gate['reason'] = hold['reason']
+            # A classifier hold is the deciding reason (for example a
+            # reviewer-graded type), so keep it in front of the fidelity
+            # reason instead of letting the gate reason hide it.
+            if result.get('held') and result.get('reason'):
+                if result['reason'] not in hold['reason']:
+                    hold['reason'] = result['reason'] + '; ' + hold['reason']
