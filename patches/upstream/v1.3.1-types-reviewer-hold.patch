diff --git a/scripts/qtypes.py b/scripts/qtypes.py
index 98fac51..89107aa 100644
--- a/scripts/qtypes.py
+++ b/scripts/qtypes.py
@@ -252,6 +252,21 @@ def classify_detailed(item, visual=None, ocr=None, rules=None, min_confidence=No
     matched = [rule for rule in (rules.get('rules') or []) if _rule_matches(rule, item, visual, marks)]
     matched_ids = [rule.get('id') for rule in matched]
     hard_base = dict(matched_rules=matched_ids, markers=marks)
+    # Reviewer-graded types are never auto-built from a PDF. If the stem
+    # carries one of their markers, hold with that reason before any
+    # matching rule can assign a different (wrong) type. A lab or code
+    # item with lettered options would otherwise match single_choice.
+    reviewer_types = ('lab_task', 'code_answer', 'terminal_task',
+                      'simulation_ui', 'audio_response', 'long_answer')
+    for typ in reviewer_types:
+        if typ in marks:
+            template = (rules.get('hold') or {}).get(
+                'reviewer_graded',
+                'reviewer-graded type {type} is never auto-built from a PDF')
+            reason = template.replace('{type}', typ)
+            return dict(type=typ, reason=reason, held=True,
+                        hold_reasons=hold_notes + [reason],
+                        rule_id=None, **hard_base)
     if hard and not (item.get('options') or {}):
         # already returned above; keep matched_rules on that path too
         pass
