+def _noisy_detail(detail):
+    """True when a method's marks are mostly outside the cells or choices.
+
+    A detector that reads text letters as boxes puts most of its marks
+    outside any cell (for example 100 outside and 4 inside). Its key is a
+    guess from the few marks that happen to fall in cells. The 3x bar is
+    conservative: noise here is 20x or more, a real method with a few stray
+    marks is under 2x. The matrix detail names the inside count
+    marks_in_cells, the dropdown detail names it marks_on_choices.
+    """
+    inside = int(
+        (detail or {}).get('marks_in_cells')
+        or (detail or {}).get('marks_on_choices')
+        or 0
+    )
+    outside = int((detail or {}).get('marks_outside') or 0)
+    return outside > 3 * max(1, inside)
+
+
+def _drop_noisy_disagreements(key_by_method, method_detail):
+    """Drop a noisy method's key only when the methods disagree.
+
+    When every method that voted agrees, nothing is dropped: a noisy-looking
+    method that agrees with the others is still a real vote, and dropping it
+    could break the two-method agreement. When the methods disagree, the
+    keys from methods whose marks are mostly outside the cells are dropped,
+    because they are the noise that vetoes the methods that read the real
+    marks. Returns the filtered key map.
+    """
+    present = {n: v for n, v in (key_by_method or {}).items() if v}
+    groups = {}
+    for n, v in present.items():
+        groups.setdefault(json.dumps(v, sort_keys=True), []).append(n)
+    if len(groups) <= 1:
+        return key_by_method
+    kept = {
+        n: v
+        for n, v in present.items()
+        if not _noisy_detail((method_detail or {}).get(n))
+    }
+    if not kept:
+        return key_by_method
+    return kept
+
+
 def _agreed(key_by_method, want=2):
