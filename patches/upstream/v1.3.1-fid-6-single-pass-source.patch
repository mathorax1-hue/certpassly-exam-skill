+def _single_pass_ocr_tokens(ocr_item, cfg):
+    """Tokens read by images with fewer than two OCR passes.
+
+    A single pass has no second read to confirm it, so its words are only
+    trusted on a screenshot-only page when the PDF text layer agrees with
+    them. Images with two or more passes contribute nothing here.
+    """
+    out = set()
+    for im in (ocr_item or {}).get('images') or []:
+        passes = im.get('passes') or {}
+        if len(passes) < 2:
+            out |= token_set(ocr_words_text({'images': [im]}), cfg)
+    return out
+
