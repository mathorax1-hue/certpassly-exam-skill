+            ]},
+            'psm6': {'words': [
+                {'text': 'publish', 'conf': 94.0},
+                {'text': 'RTT', 'conf': 91.0},
+            ]},
+        }}]}
+        good = 'publish ONLY the RTT value'
+        verdict = AI.accept_ai_text(good, ocr_item, item, min_conf=90)
+        self.assertTrue(verdict['ok'], verdict)
