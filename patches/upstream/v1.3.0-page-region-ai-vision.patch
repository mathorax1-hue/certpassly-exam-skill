+#!/usr/bin/env python3
+"""Pluggable AI vision hook for OCR-held items. Off by default. No auto-fill."""
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime, timezone
+
+import fidelity
+from ocr_retry import file_sha256
+
+
+def vision_config(ocr_cfg=None):
+    cfg = dict((ocr_cfg or {}).get('ai_vision') or {})
+    cfg.setdefault('enabled', False)
+    cfg.setdefault('provider', 'none')
+    cfg.setdefault('accept_ocr_word_confidence', 90)
+    return cfg
+
+
+def find_reads_paths(root, exam, explicit=None, out_dir=None):
+    paths = []
+    if explicit:
+        paths.append(explicit)
+    roots = []
+    for r in (root, out_dir):
+        if r:
+            roots.append(r)
+    try:
+        import paths as P
+        if P.root():
+            roots.append(P.root())
+    except Exception:
+        pass
+    seen = set()
+    out = []
+    for r in roots:
+        r = os.path.abspath(r)
+        if r in seen:
+            continue
+        seen.add(r)
+        for cand in (
+            os.path.join(r, 'review', 'ai-reads.json'),
+            os.path.join(r, 'exams', exam or '', 'review', 'ai-reads.json'),
+        ):
+            if cand not in out:
+                out.append(cand)
+        folder = os.path.join(r, 'review', 'ai-reads')
+        if os.path.isdir(folder):
+            for name in sorted(os.listdir(folder)):
+                if name.endswith('.json'):
+                    out.append(os.path.join(folder, name))
+        # out_dir is often workspace/out/CODE; also check workspace/review
+        parent = os.path.dirname(r)
+        if os.path.basename(parent) == 'out':
+            out.append(os.path.join(os.path.dirname(parent), 'review', 'ai-reads.json'))
+            folder = os.path.join(os.path.dirname(parent), 'review', 'ai-reads')
+            if os.path.isdir(folder):
+                for name in sorted(os.listdir(folder)):
+                    if name.endswith('.json'):
+                        out.append(os.path.join(folder, name))
+    return out
+
+
+def _load_json(path):
+    if not path or not os.path.isfile(path):
+        return None
+    with open(path, encoding='utf-8') as fh:
+        return json.load(fh)
+
+
+def _rows_from(data, path):
+    rows = []
+    if isinstance(data, dict):
+        if data.get('question_key') or data.get('transcribed_text'):
+            rec = dict(data)
+            rec['_source_path'] = path
+            rows.append(rec)
+        for key in ('items', 'reads', 'ai_reads'):
+            if isinstance(data.get(key), list):
+                for row in data[key]:
+                    if isinstance(row, dict):
+                        rec = dict(row)
+                        rec['_source_path'] = path
+                        rows.append(rec)
+    elif isinstance(data, list):
+        for row in data:
+            if isinstance(row, dict):
+                rec = dict(row)
+                rec['_source_path'] = path
+                rows.append(rec)
+    return rows
+
+
+def is_complete_read(row):
+    if not isinstance(row, dict):
+        return False
+    key = str(row.get('question_key') or row.get('id') or '').strip()
+    text = str(row.get('transcribed_text') or row.get('text') or '').strip()
+    return bool(key and text)
+
+
+def load_reads(root, exam, explicit=None, out_dir=None) -> dict:
+    """Load committed AI reads. Never invents text. Empty files are ignored."""
+    out = {}
+    for path in find_reads_paths(root, exam, explicit, out_dir):
+        data = _load_json(path)
+        if data is None:
+            continue
+        for row in _rows_from(data, path):
+            if not is_complete_read(row):
+                continue
+            key = str(row.get('question_key') or row.get('id'))
+            rec = dict(row)
+            rec['source'] = rec.get('source') or rec.get('model') or 'ai_vision'
+            out[key] = rec
+    return out
+
+
+def high_conf_words_by_pass(ocr_item, min_conf=90, fid_cfg=None):
+    """Token sequences of OCR words at or above min_conf, one list per pass id."""
+    by_pass = {}
+    for im in (ocr_item or {}).get('images') or []:
+        if not isinstance(im, dict):
+            continue
+        passes = im.get('passes') or {}
+        if passes:
+            for pid, rec in passes.items():
+                if not isinstance(rec, dict):
+                    continue
+                words = rec.get('words')
+                seq = by_pass.setdefault(str(pid), [])
+                if words:
+                    for w in words:
+                        try:
+                            conf = float(w.get('conf'))
+                        except (TypeError, ValueError, AttributeError):
+                            continue
+                        if conf < min_conf:
+                            continue
+                        seq.extend(fidelity.tokenize(w.get('text') or '', fid_cfg))
+                elif rec.get('text'):
+                    # Old extracts may lack per-word lists; cannot apply the
+                    # confidence filter, so skip this pass rather than guess.
+                    by_pass.setdefault(str(pid), [])
+        else:
+            seq = by_pass.setdefault('primary', [])
+            for w in im.get('words') or []:
+                try:
+                    conf = float(w.get('conf'))
+                except (TypeError, ValueError, AttributeError):
+                    continue
+                if conf < min_conf:
+                    continue
+                seq.extend(fidelity.tokenize(w.get('text') or '', fid_cfg))
+    return by_pass
+
+
+def is_subsequence(need, have) -> bool:
+    i = 0
+    for tok in have:
+        if i < len(need) and tok == need[i]:
+            i += 1
+    return i == len(need)
+
+
+def accept_ai_text(ai_text, ocr_item, item, fid_cfg=None, deny=None, min_conf=90):
+    """Strict acceptance. Does not invent text or lower the fidelity floors.
+
+    High-confidence words are taken from the original dual OCR passes, not from
+    a later failed retry that may have invented tokens.
+    """
+    fid_cfg = fid_cfg or {}
+    reasons = []
+    ai_tokens = fidelity.tokenize(ai_text or '', fid_cfg)
+    by_pass = high_conf_words_by_pass(ocr_item, min_conf=min_conf, fid_cfg=fid_cfg)
+    if not by_pass:
+        reasons.append('no OCR high-confidence words were available to check')
+    for pid, need in by_pass.items():
+        if need and not is_subsequence(need, ai_tokens):
+            missing = [t for t in need if t not in ai_tokens]
+            reasons.append(
+                'AI text is missing high-confidence OCR words from pass %s in order%s' % (
+                    pid, (': ' + ', '.join(missing[:12])) if missing else ''))
+    pdf = fidelity.source_pdf_text(item, fid_cfg, deny=deny)
+    pdf_tokens = fidelity.tokenize(pdf, fid_cfg)
+    # PDF words may already live in the text-layer stem/options. The image
+    # transcription is not required to repeat the stem. Coverage is checked
+    # against the AI text plus the extracted text-layer stem and choices.
+    layer = ' '.join([
+        ai_text or '',
+        item.get('stem') or '',
+        ' '.join(str(v) for v in (item.get('options') or {}).values()),
+        item.get('source_text') or '',
+    ])
+    covered = fidelity.tokenize(layer, fid_cfg)
+    missing_pdf = [t for t in pdf_tokens if t not in set(covered)]
+    if missing_pdf:
+        reasons.append('PDF text layer words not covered: ' + ', '.join(missing_pdf[:20]))
+    ok = not reasons
+    return {
+        'ok': ok,
+        'reasons': reasons,
+        'reason': '; '.join(reasons),
+        'ai_token_count': len(ai_tokens),
+        'pdf_word_count': len(pdf_tokens),
+        'passes_checked': sorted(by_pass),
+    }
+
+
+def mark_reviewer_needed(question):
+    """Set reviewer_needed on the site answer only. No extra schema-forbidden fields."""
+    q = dict(question or {})
+    answer = dict(q.get('answer') or {})
+    answer['reviewer_needed'] = True
+    q['answer'] = answer
+    return q
+
+
+def build_record(item, read, verdict, now=None):
+    now = now or datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
+    return {
+        'question_key': (item or {}).get('question_key') or read.get('question_key'),
+        'accepted': bool(verdict and verdict.get('ok')),
+        'source': read.get('source') or 'ai_vision',
+        'model': read.get('model') or read.get('source') or 'ai_vision',
+        'confidence': read.get('confidence'),
+        'image_sha256': read.get('image_sha256') or '',
+        'source_path': read.get('_source_path') or '',
+        'reason': '' if (verdict or {}).get('ok') else ((verdict or {}).get('reason') or ''),
+        'recorded_at': now,
+        'transcribed_text': read.get('transcribed_text') or read.get('text') or '',
+    }
+
+
+def write_report(out_dir, exam, records):
+    export_dir = os.path.join(out_dir, 'export')
+    os.makedirs(export_dir, exist_ok=True)
+    path = os.path.join(export_dir, 'ai-vision.json')
+    accepted = sum(1 for r in records if r.get('accepted'))
+    payload = {
+        'exam': exam,
+        'count': len(records),
+        'accepted': accepted,
+        'rejected': len(records) - accepted,
+        'note': 'AI vision provenance. This file is a raw-exam report, not a site v2 field.',
+        'items': records,
+    }
+    with open(path, 'w', encoding='utf-8') as fh:
+        json.dump(payload, fh, indent=2, ensure_ascii=False)
+        fh.write('\n')
+    return path
+
+
+def run_provider(item, images, cfg):
+    """Extension point. Returns None when disabled or no provider is configured.
+
+    Actions has no AI key; provider stays 'none' and enabled stays false there.
+    A local or future provider can return a dict with transcribed_text.
+    """
+    vcfg = vision_config(cfg if isinstance(cfg, dict) and 'ai_vision' in (cfg or {}) else {'ai_vision': cfg or {}})
+    if isinstance(cfg, dict) and 'provider' in cfg:
+        vcfg = vision_config({'ai_vision': cfg})
+    if not vcfg.get('enabled'):
+        return None
+    provider = str(vcfg.get('provider') or 'none').strip().lower()
+    if provider in ('', 'none', 'off', 'disabled'):
+        return None
+    hook = vcfg.get('hook_module')
+    if not hook:
+        return None
+    import importlib
+    mod = importlib.import_module(hook)
+    fn = getattr(mod, 'transcribe_item', None)
+    if not callable(fn):
+        return None
+    return fn(item, images, vcfg)
