+def find_raw_xml(out_dir):
+    for cand in (
+        os.path.join(out_dir, 'extracted', 'raw.xml'),
+        os.path.join(out_dir, 'raw.xml'),
+    ):
+        if cand and os.path.isfile(cand):
+            return cand
+    return None
+
+
+def parse_pdftohtml_images(xml_path):
+    """Map image basenames to pdftohtml boxes and page size."""
+    if not xml_path or not os.path.isfile(xml_path):
+        return {}
+    with open(xml_path, encoding='utf-8', errors='replace') as fh:
+        text = fh.read()
+    pages = {}
+    out = {}
+    for pm in re.finditer(
+        r'<page[^>]*number="(\d+)"[^>]*(?:[^>]*width="(\d+)"[^>]*height="(\d+)"|[^>]*height="(\d+)"[^>]*width="(\d+)")[^>]*>(.*?)</page>',
+        text, re.S | re.I):
+        page = int(pm.group(1))
+        if pm.group(2) and pm.group(3):
+            pw, ph = int(pm.group(2)), int(pm.group(3))
+        else:
+            ph, pw = int(pm.group(4)), int(pm.group(5))
+        pages[page] = {'width': pw, 'height': ph}
+        body = pm.group(6)
+        for im in re.finditer(
+            r'<image\s+top="(\d+)"\s+left="(\d+)"\s+width="(\d+)"\s+height="(\d+)"\s+src="([^"]+)"',
+            body, re.I):
+            src = os.path.basename(im.group(5).replace('\\', '/'))
+            out[src] = {
+                'page': page,
+                'top': int(im.group(1)),
+                'left': int(im.group(2)),
+                'width': int(im.group(3)),
+                'height': int(im.group(4)),
+                'page_width': pw,
+                'page_height': ph,
+            }
+        # attribute order variants
+        for im in re.finditer(r'<image\b([^>]+)>', body, re.I):
+            attrs = im.group(1)
+            src_m = re.search(r'\bsrc="([^"]+)"', attrs)
+            if not src_m:
+                continue
+            src = os.path.basename(src_m.group(1).replace('\\', '/'))
+            if src in out:
+                continue
+            def _num(name):
+                m = re.search(r'\b%s="(\d+)"' % name, attrs)
+                return int(m.group(1)) if m else None
+            top, left, width, height = _num('top'), _num('left'), _num('width'), _num('height')
+            if None in (top, left, width, height):
+                continue
+            out[src] = {
+                'page': page, 'top': top, 'left': left, 'width': width, 'height': height,
+                'page_width': pw, 'page_height': ph,
+            }
+    return out
+
+
+def xml_box_to_pixels(box, raster_w, raster_h, padding=12):
+    """Convert a pdftohtml image box to a crop on a raster page."""
+    pw = float(box.get('page_width') or 0) or 1.0
+    ph = float(box.get('page_height') or 0) or 1.0
+    sx = float(raster_w) / pw
+    sy = float(raster_h) / ph
+    pad = int(padding or 0)
+    x0 = max(0, int(round(box['left'] * sx)) - pad)
+    y0 = max(0, int(round(box['top'] * sy)) - pad)
+    x1 = min(int(raster_w), int(round((box['left'] + box['width']) * sx)) + pad)
+    y1 = min(int(raster_h), int(round((box['top'] + box['height']) * sy)) + pad)
+    if x1 <= x0 or y1 <= y0:
+        return None
+    return (x0, y0, x1, y1)
+
+
+def crop_raster_region(raster_path, box, dest_path, padding=12):
+    img = cv2.imread(raster_path, cv2.IMREAD_COLOR)
+    if img is None:
+        return None
+    h, w = img.shape[:2]
+    rect = xml_box_to_pixels(box, w, h, padding=padding)
+    if not rect:
+        return None
+    x0, y0, x1, y1 = rect
+    crop = img[y0:y1, x0:x1]
+    if crop.size == 0:
+        return None
+    os.makedirs(os.path.dirname(dest_path) or '.', exist_ok=True)
+    if not cv2.imwrite(dest_path, crop):
+        return None
+    return dest_path
+
+
+def _raster_cache_key(pdf, page, dpi):
+    return '%s:%s:%s' % (os.path.abspath(pdf or ''), page, int(dpi))
+
+
+_PAGE_RASTER_CACHE = {}
+
+
+def raster_page_cached(pdf, dest_dir, page, dpi, prefix='page-region'):
+    key = _raster_cache_key(pdf, page, dpi)
+    cached = _PAGE_RASTER_CACHE.get(key)
+    if cached and os.path.isfile(cached):
+        return cached
+    fn = O.raster_page(pdf, dest_dir, page, dpi, prefix='%s-%s' % (prefix, page))
+    if not fn:
+        return None
+    path = os.path.join(dest_dir, fn)
+    _PAGE_RASTER_CACHE[key] = path
+    return path
+
+
+def retry_page_region(item, ocr_item, out_dir, pdf, cfg=None, xml_path=None):
+    """Second scripted attempt: crop the question region from a 400 dpi page render."""
+    cfg = cfg if isinstance(cfg, dict) else (V.load_ocr_config() or {})
+    retry_cfg = retry_config(cfg)
+    region_cfg = dict(retry_cfg.get('page_region') or {})
+    key = (item or {}).get('question_key') or 'unknown'
+    dest_dir = os.path.join(out_dir, 'media', 'page-region')
+    os.makedirs(dest_dir, exist_ok=True)
+    log = {
+        'question_key': key,
+        'attempted': True,
+        'stage': 'page_region',
+        'dpi': region_cfg.get('dpi') or 400,
+        'source_images': [],
+        'retry_images': [],
+        'pdf_raster': [],
+        'outcome': 'still_held',
+        'notes': [],
+    }
+    if not region_cfg.get('enabled', True):
+        log['attempted'] = False
+        log['outcome'] = 'skipped'
+        log['notes'].append('page_region retry disabled')
+        return ocr_item, log
+    if not pdf or not os.path.isfile(pdf):
+        log['outcome'] = 'no_retry_image'
+        log['notes'].append('PDF not found for page-region retry')
+        return ocr_item, log
+    xml_path = xml_path or find_raw_xml(out_dir)
+    boxes = parse_pdftohtml_images(xml_path) if xml_path else {}
+    if not boxes:
+        log['outcome'] = 'no_retry_image'
+        log['notes'].append('no pdftohtml image boxes in raw.xml')
+        return ocr_item, log
+    sources = list((item or {}).get('question_images') or [])
+    sources += [fn for fn in (item or {}).get('answer_images') or [] if fn not in sources]
+    if not sources:
+        log['outcome'] = 'no_retry_image'
+        log['notes'].append('item has no images to locate on the page')
+        return ocr_item, log
+    dpi = int(region_cfg.get('dpi') or 400)
+    padding = int(region_cfg.get('padding_px') or 12)
+    enhance_cfg = {
+        'scale': float(region_cfg.get('enhance_scale') or 1),
+        'grayscale': region_cfg.get('grayscale', True),
+        'sharpen': region_cfg.get('sharpen', True),
+        'contrast': region_cfg.get('contrast', 1.5),
+        'clahe': region_cfg.get('clahe', True),
+        'binarize': region_cfg.get('binarize', False),
+        'brightness': region_cfg.get('brightness') or 0,
+    }
+    enhanced_names = []
+    used_paths = []
+    rasters_done = {}
+    for fn in sources:
+        base = os.path.basename(fn)
+        box = boxes.get(base)
+        if not box:
+            log['notes'].append('no xml box for %s' % base)
+            continue
+        page = box['page']
+        if page not in rasters_done:
+            raster_path = raster_page_cached(pdf, dest_dir, page, dpi)
+            rasters_done[page] = raster_path
+            if raster_path:
+                log['pdf_raster'].append({'page': page, 'file': os.path.basename(raster_path), 'dpi': dpi})
+        raster_path = rasters_done.get(page)
+        if not raster_path:
+            log['notes'].append('raster failed for page %s' % page)
+            continue
+        crop_name = '%s-p%s-%s' % (key, page, _safe_name(base))
+        crop_path = os.path.join(dest_dir, 'crop-' + crop_name)
+        cropped = crop_raster_region(raster_path, box, crop_path, padding=padding)
+        if not cropped:
+            log['notes'].append('crop failed for %s' % base)
+            continue
+        dest_name = '%s-%s' % (key, _safe_name(base))
+        dest = os.path.join(dest_dir, dest_name)
+        written = enhance_image(cropped, dest, enhance_cfg)
+        if not written:
+            log['notes'].append('enhance failed for %s' % base)
+            continue
+        log['source_images'].append(base)
+        enhanced_names.append(dest_name)
+        used_paths.append(written)
+        log['retry_images'].append({
+            'file': dest_name,
+            'source': base,
+            'sha256': file_sha256(written),
+            'crop': os.path.basename(crop_path),
+        })
+    if not used_paths:
+        log['outcome'] = 'no_retry_image'
+        log['notes'].append('no page-region crop could be enhanced')
+        return ocr_item, log
+    images = []
+    confs = []
+    notes = list((ocr_item or {}).get('notes') or [])
+    notes.append('ocr retry on 400 dpi page-region crops')
+    for dest_name, dest_path in zip(enhanced_names, used_paths):
+        rec_img, _lines = O.ocr_image(dest_dir, dest_name, cfg, 'question-page-region')
+        rec_img['retry'] = True
+        rec_img['page_region'] = True
+        rec_img['source_file'] = dest_name
+        images.append(rec_img)
+        if rec_img.get('mean_confidence') is not None:
+            confs.append(rec_img['mean_confidence'])
+        if rec_img.get('notes'):
+            notes.extend(rec_img['notes'])
+    mean = round(sum(confs) / len(confs), 1) if confs else None
+    mins = [im.get('min_confidence') for im in images if im.get('min_confidence') is not None]
+    minc = min(mins) if mins else None
+    agree = all(im.get('agree', True) for im in images) if images else True
+    new_ocr = dict(ocr_item or {})
+    new_ocr.update({
+        'question_key': key,
+        'images': images,
+        'confidence': mean,
+        'min_confidence': minc,
+        'notes': notes,
+        'agree': agree,
+        'retry_applied': True,
+        'page_region_applied': True,
+    })
+    log['after'] = {
+        'min_confidence': minc,
+        'overall_confidence': mean,
+        'agree': agree,
+        'image_count': len(images),
+    }
+    log['before'] = {
+        'min_confidence': (ocr_item or {}).get('min_confidence'),
+        'overall_confidence': (ocr_item or {}).get('confidence'),
+        'agree': (ocr_item or {}).get('agree'),
+    }
+    return new_ocr, log
