     return {'cloze': {'segments': segments, 'blanks': blanks_out}, '_option_id_map': option_id_map}
 
 
+def drag_slot_out(slot, index):
+    """One drag_drop slot as the site expects it. A plain string stays a
+    string. An object keeps its id and label, with optional shape and
+    coords. Coords follow the hotspot rule: every number must be in 0..1,
+    otherwise the coords are dropped and only id and label are kept."""
+    if not isinstance(slot, dict):
+        return str(slot) or ' '
+    out = {
+        'id': str(slot.get('id') or f'slot{index + 1}'),
+        'label': (slot.get('label') or slot.get('text')
+                  or str(slot.get('id') or '') or ' '),
+    }
+    shape = slot.get('shape')
+    if isinstance(shape, str) and shape in ('rect', 'circle', 'polygon'):
+        out['shape'] = shape
+    coords = slot.get('coords') or slot.get('normalized_coordinates') or []
+    nums = []
+    ok = True
+    for c in coords:
+        try:
+            n = float(c)
+        except (TypeError, ValueError):
+            ok = False
+            break
+        if n < 0 or n > 1:
+            ok = False
+            break
+        nums.append(n)
+    if ok and nums:
+        out['coords'] = nums
+    return out
+
+
