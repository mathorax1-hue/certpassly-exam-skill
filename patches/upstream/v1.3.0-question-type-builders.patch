diff --git a/scripts/text_structures.py b/scripts/text_structures.py
new file mode 100644
index 0000000..28933fd
--- /dev/null
+++ b/scripts/text_structures.py
@@ -0,0 +1,289 @@
+"""Text-layer question structures that are not plain lettered choices.
+
+No AI. Every structure is read only from the PDF text layer of one item:
+the stem lines, the lettered options and the answer line. When anything is
+not exact (an unmapped letter, a missing item, a reused or unused target the
+site cannot show) the parser returns no structure and a reason, and the item
+is held. Nothing is guessed.
+
+Supported source shapes (documented in reference/question-type-layouts.md):
+
+ordering        lettered steps, stem asks for an order, answer lists every
+                letter once in the right order ("C, A, D, B").
+matching        numbered items in the stem, lettered targets, answer pairs
+                ("1-B, 2-A, 3-C"); every target is used, every item once.
+categorization  numbered items, lettered categories, answer pairs; a
+                category may hold many items or none.
+drag_drop       DRAG DROP marker, numbered items, lettered slots, answer pairs.
+scenario        "Scenario:" block, then the question, then lettered options,
+                one answer letter.
+case_study      "Case Study" block shared by the next questions until the
+                "End of Case Study" line (or the next case study).
+"""
+import re
+
+NUM_LINE = re.compile(r'^(\d{1,2})[.)]\s+(.+)$')
+PAIR = re.compile(r'(\d{1,2})\s*(?:-|:|=|->|\u2192|>)\s*([A-Fa-f])\b')
+LETTERS = re.compile(r'[A-F]')
+
+MARKERS = {
+    'ordering': re.compile(r'\b(correct|right|proper)\s+(order|sequence)\b|\barrange\b|\bin\s+sequence\b', re.I),
+    'matching': re.compile(r'\bmatch\s+(each|the)\b', re.I),
+    'categorize': re.compile(r'\b(categori[sz]e|classify)\b', re.I),
+    'dragdrop': re.compile(r'DRAG DROP|\bdrag\s+(each|the)\b'),
+}
+SCENARIO_RX = re.compile(r'^\s*Scenario\s*:\s*(.*)$', re.I)
+CASE_START = re.compile(r'^\s*Case\s+Study(?:\s+\d+)?\s*[:.-]?\s*(.*)$', re.I)
+CASE_END = re.compile(r'^\s*End\s+of\s+Case\s+Study\s*\.?\s*$', re.I)
+
+
+def natural_key(s):
+    """PHP sort($a, SORT_NATURAL | SORT_FLAG_CASE) order, as the matching component uses."""
+    parts = re.split(r'(\d+)', (s or '').lower())
+    return [(0, int(p), '') if p.isdigit() else (1, 0, p) for p in parts]
+
+
+def _stem_lines(item):
+    """Source lines that belong to the stem (before the first lettered option)."""
+    lines = [l.strip() for l in (item.get('source_text') or '').split('\n') if l.strip()]
+    opts = item.get('options') or {}
+    out = []
+    for l in lines:
+        if re.match(r'^\(?[A-F][.):]\s', l) or re.match(r'^\(?[A-F][.):]$', l):
+            if opts:
+                break
+        out.append(l)
+    return out
+
+
+def numbered_items(item):
+    """(intro text, [item texts]) from numbered stem lines, or (None, reason)."""
+    lines = _stem_lines(item)
+    intro, items, cur = [], [], None
+    expect = 1
+    for l in lines:
+        m = NUM_LINE.match(l)
+        if m and int(m.group(1)) == expect:
+            cur = [m.group(2).strip()]
+            items.append(cur)
+            expect += 1
+            continue
+        if cur is None:
+            intro.append(l)
+        else:
+            cur.append(l)
+    if len(items) < 2:
+        return None, 'fewer than two numbered items in the stem'
+    return {'intro': ' '.join(intro).strip(), 'items': [' '.join(x).strip() for x in items]}, None
+
+
+def _targets(item):
+    opts = item.get('options') or {}
+    keys = sorted(opts, key=lambda k: k.lower())
+    return keys, [opts[k] for k in keys]
+
+
+def answer_pairs(raw, n_items, n_targets):
+    """{item index: target index} from "1-B, 2-A". Every item exactly once."""
+    pairs = PAIR.findall(raw or '')
+    if not pairs:
+        return None, 'answer line has no item-letter pairs'
+    rest = PAIR.sub(' ', raw or '')
+    if re.search(r'[A-Za-z0-9]', re.sub(r'[,;\s]+', ' ', rest)):
+        return None, 'answer line has text that is not an item-letter pair'
+    out = {}
+    for n, L in pairs:
+        i = int(n) - 1
+        t = ord(L.upper()) - ord('A')
+        if not (0 <= i < n_items) or not (0 <= t < n_targets):
+            return None, 'answer pair %s-%s does not map to an item and a target' % (n, L)
+        if i in out:
+            return None, 'item %s has more than one answer' % n
+        out[i] = t
+    if len(out) != n_items:
+        return None, 'not every numbered item has an answer'
+    return out, None
+
+
+def parse_ordering(item):
+    keys, texts = _targets(item)
+    if len(keys) < 2:
+        return None, 'ordering needs at least two lettered steps'
+    raw = (item.get('answer_raw') or '').upper()
+    if re.search(r'[^A-F,;\s>\-\u2192]', raw):
+        return None, 'ordering answer line has text that is not a letter sequence'
+    letters = LETTERS.findall(raw)
+    idx = [ord(L) - ord('A') for L in letters]
+    if len(idx) != len(set(idx)):
+        return None, 'ordering answer repeats a step'
+    if sorted(idx) != list(range(len(keys))):
+        return None, 'ordering answer does not use every step exactly once (the site ordering type has no unused steps)'
+    return {'type': 'ordering', 'items': texts, 'key': idx, 'source': 'text'}, None
+
+
+def _pair_struct(item, kind):
+    base, why = numbered_items(item)
+    if not base:
+        return None, why
+    keys, targets = _targets(item)
+    if len(targets) < 2:
+        return None, 'fewer than two lettered targets'
+    pairs, why = answer_pairs(item.get('answer_raw'), len(base['items']), len(targets))
+    if pairs is None:
+        return None, why
+    if kind == 'matching':
+        used = set(pairs.values())
+        if used != set(range(len(targets))):
+            return None, 'a target is never used; the site matching type only shows paired targets'
+        if len(set(targets)) != len(targets):
+            return None, 'two targets have the same text'
+        order = sorted(range(len(targets)), key=lambda t: natural_key(targets[t]))
+        pos = {t: order.index(t) for t in range(len(targets))}
+        key = {str(i): str(pos[t]) for i, t in sorted(pairs.items())}
+        return {'type': 'matching', 'intro': base['intro'], 'items': base['items'], 'targets': targets,
+                'pairs': [[base['items'][i], targets[t]] for i, t in sorted(pairs.items())],
+                'key': key, 'source': 'text'}, None
+    key = {str(i): str(t) for i, t in sorted(pairs.items())}
+    return {'type': kind, 'intro': base['intro'], 'items': base['items'], 'slots': targets,
+            'key': key, 'source': 'text'}, None
+
+
+def parse_scenario(item):
+    lines = _stem_lines(item)
+    if not lines:
+        return None, 'no stem'
+    m = SCENARIO_RX.match(lines[0])
+    if not m:
+        return None, 'no Scenario: label'
+    body = ([m.group(1).strip()] if m.group(1).strip() else []) + lines[1:]
+    # the question is the last stem line ending with a question mark, or a "Question:" line
+    q_at = None
+    for i, l in enumerate(body):
+        if re.match(r'^\s*Question\s*:', l, re.I):
+            q_at = i
+    if q_at is None:
+        for i in range(len(body) - 1, -1, -1):
+            if body[i].rstrip().endswith('?'):
+                q_at = i
+                break
+        # a question sentence may wrap over lines: walk back to the line after the last full stop
+        if q_at is not None:
+            j = q_at
+            while j > 0 and not re.search(r'[.!?:]\s*$', body[j - 1]):
+                j -= 1
+            q_at = j
+    if q_at == 0 and len(body) >= 1:
+        # scenario and question on one line: the question is the last sentence
+        text = ' '.join(body).strip()
+        parts = re.split(r'(?<=[.!])\s+(?=[A-Z])', text)
+        if len(parts) >= 2 and parts[-1].rstrip().endswith('?'):
+            body = [' '.join(parts[:-1]), parts[-1]]
+            q_at = 1
+    if q_at is None or q_at == 0:
+        return None, 'scenario text and question could not be told apart'
+    scen = ' '.join(body[:q_at]).strip()
+    question = ' '.join(body[q_at:]).strip()
+    question = re.sub(r'^\s*Question\s*:\s*', '', question, flags=re.I)
+    return {'type': 'scenario', 'scenario': scen, 'question': question,
+            'scenario_label': lines[0][:m.start(1)].strip() if m.group(1) else lines[0].strip()}, None
+
+
+def detect(item, marks=None):
+    """Return (structure or None, reason or None, strong).
+
+    strong is True when the source clearly has this structure (an ordering
+    marker with a letter sequence, or item-letter pairs in the answer line) but
+    it could not be read exactly. The caller holds such an item instead of
+    letting it fall back to a plain choice type.
+    """
+    stem = item.get('stem') or ''
+    raw = item.get('answer_raw') or ''
+    found = {k for k, rx in MARKERS.items() if rx.search(stem)}
+    has_pairs = bool(PAIR.search(raw))
+    if item.get('_case_study'):
+        st, why = parse_case_member(item)
+        return st, why, True
+    if SCENARIO_RX.match((_stem_lines(item) or [''])[0]):
+        st, why = parse_scenario(item)
+        # an unreadable scenario split falls back to the plain choice types
+        return st, why, st is not None
+    pair_kind = None
+    if has_pairs:
+        if 'dragdrop' in found:
+            pair_kind = 'drag_drop'
+        elif 'categorize' in found and 'matching' not in found:
+            pair_kind = 'categorization'
+        elif 'matching' in found and 'categorize' not in found:
+            pair_kind = 'matching'
+        else:
+            return None, 'answer line has item-letter pairs but the stem does not say match, categorize or drag', True
+        st, why = _pair_struct(item, pair_kind)
+        return st, why, True
+    if 'ordering' in found and len(LETTERS.findall(raw.upper())) >= 2:
+        st, why = parse_ordering(item)
+        return st, why, True
+    return None, None, False
+
+
+def parse_case_member(item):
+    case = item['_case_study']
+    lines = [l.strip() for l in (item.get('source_text') or '').split('\n') if l.strip()]
+    qi = next((i for i, l in enumerate(lines) if re.match(r'^Question\s*:', l, re.I)), None)
+    if qi is None:
+        return None, 'case study question has no Question: line'
+    q_lines = []
+    for l in lines[qi:]:
+        if re.match(r'^\(?[A-F][.):](\s|$)', l):
+            break
+        q_lines.append(l)
+    question = re.sub(r'^Question\s*:\s*', '', ' '.join(q_lines), flags=re.I).strip()
+    if not question:
+        return None, 'case study question text is empty'
+    return {'type': 'case_study', 'case': case, 'question': question}, None
+
+
+def attach_case_studies(split):
+    """Group questions that share a case study.
+
+    Supported shape: the stem of a question starts with a "Case Study: <title>"
+    line, then the case text, then a "Question:" line. Later questions of the
+    same case start with the same "Case Study: <title>" line; their case text
+    may be repeated or left out. Every member gets the case text of the first
+    question that carried it (the PDF words of that text are added to the
+    member's source so the word check still covers every word). A title whose
+    repeated text differs from the first copy is a conflict and is held.
+    Returns notes for the report.
+    """
+    notes = []
+    cases = {}
+    for key in sorted(split, key=lambda k: split[k].get('source_number') or 0):
+        rec = split[key]
+        lines = [l.strip() for l in (rec.get('source_text') or '').split('\n') if l.strip()]
+        if not lines:
+            continue
+        m = CASE_START.match(lines[0])
+        if not m:
+            continue
+        title = m.group(1).strip()
+        qi = next((i for i, l in enumerate(lines) if re.match(r'^Question\s*:', l, re.I)), None)
+        if qi is None:
+            rec['_case_conflict'] = 'Case Study block without a Question: line'
+            notes.append({'question_key': key, 'note': rec['_case_conflict']})
+            continue
+        text = ' '.join(lines[1:qi]).strip()
+        known = cases.get(title.lower())
+        if known is None:
+            if not text:
+                rec['_case_conflict'] = 'first question of case study %r has no case text' % title
+                notes.append({'question_key': key, 'note': rec['_case_conflict']})
+                continue
+            known = {'title': title, 'title_line': lines[0], 'text': text, 'from': key}
+            cases[title.lower()] = known
+        elif text and text != known['text']:
+            rec['_case_conflict'] = 'case study %r text differs from the copy in %s' % (title, known['from'])
+            notes.append({'question_key': key, 'note': rec['_case_conflict']})
+            continue
+        rec['_case_study'] = known
+        rec['_case_own_text'] = bool(text)
+    # a case with a single question is still a case study group of one
+    return notes
