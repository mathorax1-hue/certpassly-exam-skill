+def ring_marks(path, dark=90):
+    """Dark closed loops (rectangles or ovals drawn around a choice). Normalized boxes.
+
+    A loop is a dark contour with a hole that fills most of its bounding box.
+    """
+    g = _gray(path)
+    if g is None:
+        return []
+    H, W = g.shape
+    e = (g < dark).astype(np.uint8)
+    cs, hier = cv2.findContours(e, cv2.RETR_CCOMP, cv2.CHAIN_APPROX_SIMPLE)
+    out = []
+    if hier is None:
+        return out
+    hier = hier[0]
+    for i, c in enumerate(cs):
+        if hier[i][3] != -1:
+            continue  # only outer contours
+        x, y, w, h = cv2.boundingRect(c)
+        if w < 14 or h < 10 or w > 0.98 * W or h > 0.9 * H:
+            continue
+        child = hier[i][2]
+        best = 0.0
+        while child != -1:
+            best = max(best, cv2.contourArea(cs[child]))
+            child = hier[child][0]
+        if best < 0.45 * w * h:
+            continue
+        ink = float(e[y:y + h, x:x + w].mean())
+        if ink > 0.5:
+            continue
+        out.append(dict(kind='ring_loop', x=x / W, y=y / H, w=w / W, h=h / H, px=[int(x), int(y), int(w), int(h)]))
+    return out
+
+
+def dropdown_key(marks, layout):
+    picks = {}
+    outside = 0
+    for m in marks or []:
+        mx0, my0, mx1, my1 = m['x'], m['y'], m['x'] + m['w'], m['y'] + m['h']
+        hit = None
+        for b in layout['blanks']:
+            for i, (x0, y0, x1, y1) in enumerate(b['choice_boxes']):
+                cx, cy = (x0 + x1) / 2.0, (y0 + y1) / 2.0
+                # the mark must enclose the choice line centre and sit on that line
+                if mx0 - 0.01 <= x0 + 0.01 and cx <= mx1 + 0.01 and my0 - 0.01 <= cy <= my1 + 0.01 and (my1 - my0) < 3.5 * (y1 - y0) + 0.02:
+                    hit = (b['id'], i)
+        if hit is None:
+            outside += 1
+            continue
+        picks.setdefault(hit[0], set()).add(hit[1])
+    detail = {'marks_on_choices': sum(len(v) for v in picks.values()), 'marks_outside': outside}
+    ids = [b['id'] for b in layout['blanks']]
+    if set(picks) != set(ids) or any(len(v) != 1 for v in picks.values()):
+        detail['reason'] = 'not exactly one marked choice in every list'
+        return None, detail
+    key = {}
+    for b in layout['blanks']:
+        key[b['id']] = b['choices'][next(iter(picks[b['id']]))]
+    return key, detail
+
+
+# ---------------------------------------------------------------- OCR scope for the fidelity gate
+
+def _word_box(w):
+    x = float(w.get('x') or 0); y = float(w.get('y') or 0)
+    ww = float(w.get('w') or 0); hh = float(w.get('h') or 0)
+    return x, y, x + ww, y + hh
+
+
+def _inside(cx, cy, box, pad=0.0):
+    x, y, w, h = box
+    return x - pad <= cx <= x + w + pad and y - pad <= cy <= y + h + pad
+
+
+def _drop_reason(w, size, labels_boxes, area, cfg):
+    W, H = size
+    if not W or not H:
+        return None
+    x0, y0, x1, y1 = _word_box(w)
+    cx = ((x0 + x1) / 2.0) / W
+    cy = ((y0 + y1) / 2.0) / H
+    t = (w.get('text') or '').strip()
+    for lb in labels_boxes:
+        if _inside(cx, cy, lb, pad=0.005):
+            return 'ui_label'
+    for c in area.get('controls') or []:
+        if _inside(cx, cy, (c['x'], c['y'], c['w'], c['h']), pad=0.012):
+            return 'control_glyph'
+    for b in area.get('blanks') or []:
+        if len(_norm(t).replace(' ', '')) <= 2 and _inside(cx, cy, tuple(b['combo']), pad=0.005):
+            return 'control_glyph'
+        if t in BORDER_GLYPHS:
+            bx, by, bw, bh = b['box']
+            if by <= cy <= by + bh and (abs(cx - bx) < 0.02 or abs(cx - (bx + bw)) < 0.02):
+                return 'border_glyph'
+    return None
+
+
+def _label_word_ids(words, cfg=None):
+    """Indexes of words that, grouped into their own text line, form a whole UI label line.
+    Each OCR pass is grouped on its own, so a label one pass read is removed only
+    from that pass."""
+    items = [(n, w) for n, w in enumerate(words or []) if isinstance(w, dict) and w.get('h')]
+    items.sort(key=lambda z: (float(z[1]['y']) + float(z[1]['h']) / 2.0, float(z[1]['x'])))
+    lines = []
+    for n, w in items:
+        cy = float(w['y']) + float(w['h']) / 2.0
+        placed = False
+        for ln in lines:
+            if abs(cy - ln['cy']) < 0.5 * max(ln['h'], float(w['h'])):
+                ln['ws'].append((n, w))
+                placed = True
+                break
+        if not placed:
+            lines.append({'cy': cy, 'h': float(w['h']), 'ws': [(n, w)]})
+    ids = set()
+    for ln in lines:
+        ws = sorted(ln['ws'], key=lambda z: float(z[1]['x']))
+        # split the visual line where a wide gap separates columns
+        seg = [ws[0]]
+        segs = []
+        for a in ws[1:]:
+            prev = seg[-1][1]
+            if float(a[1]['x']) - (float(prev['x']) + float(prev.get('w') or 0)) > 3 * ln['h']:
+                segs.append(seg)
+                seg = [a]
+            else:
+                seg.append(a)
+        segs.append(seg)
+        for sg in segs:
+            if is_ui_label(' '.join(w.get('text') or w.get('t') or '' for _, w in sg), cfg):
+                ids.update(n for n, _ in sg)
+    return ids
+
+
+def scope_ocr_item(ocr_item, visual, cfg=None):
+    """Remove answer-area chrome from the OCR words the fidelity gate checks.
+
+    Only applies when the answer-area layout was read. Removed, and listed:
+      * whole OCR lines that are a UI label (for example Answer Area, Statements)
+      * glyphs read from radio buttons, check boxes, list borders and drop-down arrows
+      * an answer image that is the question image plus answer marks
+    Every other word is kept, so the gate still sees every real word.
+    """
+    vis = visual if isinstance(visual, dict) else {}
+    area = vis.get('area') or {}
+    if not area or not isinstance(ocr_item, dict):
+        return ocr_item, None
+    cfg = cfg or DEFAULTS
+    report = {'ui_labels': [], 'ui_label_words': 0, 'control_glyphs': 0, 'border_glyphs': 0, 'answer_images_ignored': []}
+    qimg = vis.get('qimg')
+    images = []
+    for im in ocr_item.get('images') or []:
+        if im.get('role') == 'answer' and vis.get('answer_image_duplicate'):
+            report['answer_images_ignored'].append(im.get('file'))
+            continue
+        if im.get('file') != qimg:
+            images.append(im)
+            continue
+        size = im.get('size') or [0, 0]
+        W, H = (size + [0, 0])[:2]
+        labels_boxes = []
+        for ln in im.get('lines') or []:
+            if is_ui_label(ln.get('t'), cfg):
+                labels_boxes.append((ln['x'], ln['y'], ln['x1'] - ln['x'], ln['y1'] - ln['y']))
+                report['ui_labels'].append(ln.get('t'))
+        new = dict(im)
+
+        def keep(words, count=False):
+            out = []
+            label_ids = _label_word_ids(words, cfg)
+            for n, w in enumerate(words or []):
+                if not isinstance(w, dict):
+                    out.append(w)
+                    continue
+                why = 'ui_label' if n in label_ids else _drop_reason(w, (W, H), labels_boxes, area, cfg)
+                if why is None:
+                    out.append(w)
+                elif count and why in ('control_glyph', 'border_glyph'):
+                    report[why + 's'] += 1
+                elif count and why == 'ui_label':
+                    report['ui_label_words'] += 1
+            return out
+
+        new['words'] = keep(im.get('words'), count=True)
+        new['scoped'] = True
+        passes = {}
+        for pid, p in (im.get('passes') or {}).items():
+            p2 = dict(p)
+            p2['words'] = keep(p.get('words'))
+            p2['text'] = ' '.join(w.get('text') or '' for w in p2['words'] if isinstance(w, dict))
+            passes[pid] = p2
+        if passes:
+            new['passes'] = passes
+            new['agree'] = _passes_agree(passes)
+        confs = [float(w['conf']) for w in new['words'] if isinstance(w, dict) and w.get('conf') is not None]
+        new['min_confidence'] = min(confs) if confs else None
+        new['mean_confidence'] = (sum(confs) / len(confs)) if confs else None
+        new['text'] = ' '.join(w.get('text') or '' for w in new['words'] if isinstance(w, dict))
+        images.append(new)
+    out = dict(ocr_item)
+    out['images'] = images
+    out['agree'] = all(im.get('agree', True) for im in images) if images else True
+    return out, report
+
+
+def _tokens(text):
+    return re.findall(r'[a-z0-9]+', (text or '').lower())
+
+
+def _passes_agree(passes):
+    """Two passes agree when they read the same words. Reading order is not compared,
+    because column layouts are read in a different order by different page modes."""
+    bags = []
+    for p in passes.values():
+        toks = []
+        for w in p.get('words') or []:
+            if isinstance(w, dict):
+                toks.extend(_tokens(w.get('text')))
+        bags.append(sorted(toks))
+    return len({tuple(b) for b in bags}) <= 1
+
+
+# ---------------------------------------------------------------- single-choice matrix (N columns)
+
+def matrix_layout(lines, qpath, W, H, cfg=None):
+    """A grid of radio or check controls with a text header over every column.
+
+    Columns: controls cluster by x centre. Rows: controls cluster by y centre,
+    and every row needs exactly one control in every column. The header of a
+    column is the OCR words above the first row inside that column's x band.
+    Row text is the text left of the first control column. Returns
+    (layout or None, reason).
+    """
+    cfg = cfg or DEFAULTS
+    words = [w for l in lines for w in (l.get('words') or [])]
+
+    def in_word(c):
+        cx, cy = _center(c)
+        for w in words:
+            t = (w.get('t') or '').strip()
+            if re.fullmatch(r'[Oo0Q©®@°]{1,3}', t):
+                continue  # a radio read as "O" is not a word
+            if w['x'] / W <= cx <= (w['x'] + w['w']) / W and w['y'] / H <= cy <= (w['y'] + w['h']) / H:
+                return True
+        return False
+    # round letters (o, e, a) look like small rings; a control never sits inside a word
+    ctrls = [c for c in controls(qpath, cfg) if not in_word(c)]
+    if len(ctrls) < 4:
+        return None, 'fewer than four controls for a grid'
+    xs = sorted(ctrls, key=lambda c: _center(c)[0])
+    cols = []
+    for c in xs:
+        cx = _center(c)[0]
+        if cols and abs(cx - cols[-1]['x']) < 0.02:
+            cols[-1]['cs'].append(c)
+            cols[-1]['x'] = sum(_center(z)[0] for z in cols[-1]['cs']) / len(cols[-1]['cs'])
+        else:
+            cols.append({'x': cx, 'cs': [c]})
+    if len(cols) < 2:
+        return None, 'controls form fewer than two columns'
+    ys = sorted(ctrls, key=lambda c: _center(c)[1])
+    rows = []
+    for c in ys:
+        cy = _center(c)[1]
+        if rows and abs(cy - rows[-1]['y']) < 0.02:
+            rows[-1]['cs'].append(c)
+        else:
+            rows.append({'y': cy, 'cs': [c]})
+    for r in rows:
+        if len(r['cs']) != len(cols):
+            return None, 'a grid row does not have one control in every column'
+    spacing = min(b['x'] - a['x'] for a, b in zip(cols, cols[1:]))
+    half = spacing / 2.0
+    first_y = rows[0]['y']
+    top_ctrl = min(c['y'] for c in rows[0]['cs'])
+    headers = []
+    head_bottom = 0.0
+    for col in cols:
+        hw = [w for w in words
+              if abs((w['x'] + w['w'] / 2.0) / W - col['x']) <= half
+              and (w['y'] + w['h']) / H <= top_ctrl + 0.002 and (w['y'] / H) >= top_ctrl - 0.18]
+        if not hw:
+            return None, 'a grid column has no header text'
+        # keep only the header band: the lowest line of words above the first row
+        low = max((w['y'] + w['h']) / H for w in hw)
+        hw = [w for w in hw if (w['y'] + w['h']) / H >= low - 0.08]
+        hw.sort(key=lambda w: (round(w['y'] / H, 2), w['x']))
+        headers.append({'text': ' '.join(w['t'] for w in hw),
+                        'minconf': min(w['conf'] for w in hw)})
+        head_bottom = max(head_bottom, low)
+    names = [_norm(h['text']) for h in headers]
+    if len(set(names)) != len(names):
+        return None, 'two grid columns have the same header'
+    left_edge = min(c['x'] for c in cols[0]['cs']) - 0.005
+    st_lines = [l for l in lines if l['y'] >= head_bottom - 0.005 and l['x1'] < left_edge
+                and not is_ui_label(l['text'], cfg)]
+    out_rows = []
+    anchors = [r['y'] for r in rows]
+    owned = {i: [] for i in range(len(rows))}
+    for l in sorted(st_lines, key=lambda z: (z['y'], z['x'])):
+        cy = (l['y'] + l['y1']) / 2.0
+        owner = 0
+        for i, a in enumerate(anchors):
+            if a - 0.06 <= cy:
+                owner = i
+        owned[owner].append(l)
+    for i, r in enumerate(rows):
+        if not owned[i]:
+            return None, 'grid row %d has no text' % (i + 1)
+        top = (anchors[i - 1] + anchors[i]) / 2.0 if i else head_bottom
+        bot = (anchors[i] + anchors[i + 1]) / 2.0 if i + 1 < len(rows) else 1.0
+        out_rows.append(dict(id='r%d' % (i + 1), text=' '.join(l['text'] for l in owned[i]),
+                             minconf=int(min(l['minconf'] for l in owned[i])),
+                             band=[round(top, 4), round(bot, 4)]))
+    columns = {'c%d' % (i + 1): col['x'] for i, col in enumerate(cols)}
+    layout = dict(kind='choice_grid', columns=columns, column_half_width=round(half, 4),
+                  column_headers=[dict(id='c%d' % (i + 1), text=h['text'], minconf=h['minconf'])
+                                  for i, h in enumerate(headers)],
+                  header_bottom=round(head_bottom, 4), rows=out_rows,
+                  controls=[dict(x=round(c['x'], 4), y=round(c['y'], 4), w=round(c['w'], 4), h=round(c['h'], 4)) for c in ctrls])
+    if sorted(names) == ['no', 'yes']:
+        layout['yes_no_headers'] = True
+    return layout, None
+
+
+# ---------------------------------------------------------------- image hotspot (labelled boxes)
+
+def hotspot_layout(lines, qpath, W, H, cfg=None):
+    """Bordered boxes with text inside are the clickable regions.
+
+    A box is a region when OCR words sit inside it and it does not hold another
+    region. Region coords are normalized rect (x, y, width, height); the label is
+    the text inside. Returns (layout or None, reason).
+    """
+    cfg = cfg or DEFAULTS
+    boxes = list_boxes(qpath)
+    words = [w for l in lines for w in (l.get('words') or [])]
+    cands = []
+    for b in boxes:
+        bx, by, bw, bh = b
+        inside = [w for w in words if bx <= (w['x'] + w['w'] / 2.0) / W <= bx + bw
+                  and by <= (w['y'] + w['h'] / 2.0) / H <= by + bh]
+        if inside:
+            cands.append((b, inside))
+    regions = []
+    for b, inside in cands:
+        bx, by, bw, bh = b
+        holds_other = any(o is not b and bx <= o[0] and by <= o[1] and o[0] + o[2] <= bx + bw and o[1] + o[3] <= by + bh
+                          for o, _ in cands)
+        if holds_other:
+            continue
+        inside.sort(key=lambda w: (round(w['y'] / H, 2), w['x']))
+        regions.append({'box': b, 'label': ' '.join(w['t'] for w in inside),
+                        'minconf': min(w['conf'] for w in inside),
+                        'words': [w['t'] for w in inside]})
+    if len(regions) < 2:
+        return None, 'fewer than two labelled boxes'
+    regions.sort(key=lambda r: (round(r['box'][1], 2), r['box'][0]))
+    used = set()
+    for r in regions:
+        used.update(id(w) for w in words if r['box'][0] <= (w['x'] + w['w'] / 2.0) / W <= r['box'][0] + r['box'][2]
+                    and r['box'][1] <= (w['y'] + w['h'] / 2.0) / H <= r['box'][1] + r['box'][3])
+    out = []
+    for i, r in enumerate(regions):
+        x, y, w, h = r['box']
+        out.append({'id': 'h%d' % (i + 1), 'label': r['label'], 'shape': 'rect',
+                    'coords': [round(x, 4), round(y, 4), round(w, 4), round(h, 4)],
+                    'minconf': r['minconf']})
+    other = [l for l in lines if not all(id(w) in used for w in (l.get('words') or []))
+             and not is_ui_label(l['text'], cfg)]
+    return dict(kind='hotspot_boxes', regions=out,
+                other_lines=[l['text'] for l in other]), None
+
+
+def hotspot_key(marks, layout):
+    """Regions picked by one method: a mark must enclose the region centre and be
+    no more than 40% larger than the region on each side. Returns (list or None, detail)."""
+    picked = []
+    outside = 0
+    for m in marks or []:
+        mx0, my0, mx1, my1 = m['x'], m['y'], m['x'] + m['w'], m['y'] + m['h']
+        hit = None
+        for r in layout['regions']:
+            x, y, w, h = r['coords']
+            cx, cy = x + w / 2.0, y + h / 2.0
+            if mx0 <= cx <= mx1 and my0 <= cy <= my1 and (mx1 - mx0) <= 1.4 * w + 0.02 and (my1 - my0) <= 1.4 * h + 0.02:
+                hit = r['id']
+        if hit is None:
+            outside += 1
+        elif hit not in picked:
+            picked.append(hit)
+    detail = {'marks_on_regions': len(picked), 'marks_outside': outside}
+    if not picked:
+        detail['reason'] = 'no region is marked'
+        return None, detail
+    order = [r['id'] for r in layout['regions']]
+    return sorted(picked, key=order.index), detail
