--- /dev/null
+++ b/scripts/answer_area.py
@@ -0,0 +1,999 @@
+#!/usr/bin/env python3
+"""Answer-area layout reader for Yes/No grids and drop-down lists. Scripts only, no AI.
+
+The answer area is found by layout, not by words:
+  * Yes/No grid: the Yes and No column headers plus the radio or check controls
+    under them give the columns and one anchor per statement row.
+  * Drop-down: bordered list boxes give the blanks; the OCR lines inside a box
+    are its choices, in order. Text outside the boxes is the sentence.
+
+Answer marks are read by three independent pixel methods, each scoped to the
+answer area (a mark outside every cell or choice is ignored and reported):
+  * marker_box  : dark hollow rectangle drawn around the choice
+  * checked_box : small square contour with ink inside
+  * image_diff  : pixels that changed between the question image and the
+                  answer image after both are scaled to the same size
+A method gives a key only when every row or blank has exactly one marked
+cell. The fidelity gate needs two methods that agree and no method that
+disagrees. Nothing is inferred.
+"""
+from __future__ import annotations
+import os
+import re
+
+import cv2
+import numpy as np
+
+DEFAULTS = {
+    'max_aspect_delta': 0.03,
+    'diff_threshold': 60,
+    'diff_min_area_px': 40,
+    'diff_max_changed_ratio': 0.12,
+    'control_min_px': 8,
+    'control_max_px': 30,
+    'ui_labels': ['Answer Area', 'Statements', 'Statement'],
+}
+
+# Pixel method families. Two methods only count as independent when they come
+# from different families (marker_box and ring_loop both see a dark outline).
+METHOD_FAMILY = {
+    'marker_box': 'outline',
+    'ring_loop': 'outline',
+    'checked_box': 'filled_box',
+    'highlight': 'colour',
+    'image_diff': 'difference',
+}
+
+YES_WORDS = ('yes',)
+NO_WORDS = ('no',)
+
+
+def config(ocr_cfg=None):
+    cfg = dict(DEFAULTS)
+    cfg.update((ocr_cfg or {}).get('answer_area') or {})
+    return cfg
+
+
+def _norm(t):
+    return re.sub(r'[^a-z0-9]+', ' ', (t or '').lower()).strip()
+
+
+def is_ui_label(text, cfg=None):
+    labels = (cfg or DEFAULTS).get('ui_labels') or []
+    n = _norm(text)
+    return bool(n) and any(n == _norm(l) for l in labels)
+
+
+def _gray(path):
+    if not path or not os.path.isfile(path):
+        return None
+    return cv2.imread(path, cv2.IMREAD_GRAYSCALE)
+
+
+# ---------------------------------------------------------------- alignment
+
+def aligned_pair(qpath, apath, cfg=None):
+    """Scale the answer image onto the question image. Returns (q, a, info) or (None, None, info)."""
+    cfg = cfg or DEFAULTS
+    q = _gray(qpath)
+    a = _gray(apath)
+    info = {'question_image': os.path.basename(qpath or ''), 'answer_image': os.path.basename(apath or '')}
+    if q is None or a is None:
+        info['reason'] = 'image missing'
+        return None, None, info
+    qh, qw = q.shape
+    ah, aw = a.shape
+    delta = abs((qw / float(qh)) - (aw / float(ah))) / (qw / float(qh))
+    info['aspect_delta'] = round(delta, 4)
+    if delta > float(cfg.get('max_aspect_delta', 0.03)):
+        info['reason'] = 'question and answer images have a different shape'
+        return None, None, info
+    a2 = cv2.resize(a, (qw, qh), interpolation=cv2.INTER_AREA if aw > qw else cv2.INTER_CUBIC)
+    return q, a2, info
+
+
+def diff_marks(qpath, apath, cfg=None):
+    """Rectangles where the answer image differs from the question image (normalized to the question image)."""
+    cfg = cfg or DEFAULTS
+    q, a, info = aligned_pair(qpath, apath, cfg)
+    if q is None:
+        return [], info
+    H, W = q.shape
+    qb = cv2.GaussianBlur(q, (3, 3), 0)
+    ab = cv2.GaussianBlur(a, (3, 3), 0)
+    d = cv2.absdiff(qb, ab)
+    m = (d > int(cfg.get('diff_threshold', 60))).astype(np.uint8)
+    changed = float(m.mean())
+    info['changed_ratio'] = round(changed, 4)
+    if changed > float(cfg.get('diff_max_changed_ratio', 0.12)):
+        info['reason'] = 'answer image is not the question image plus marks'
+        return [], info
+    m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8))
+    n, lab, st, _ = cv2.connectedComponentsWithStats(m, 8)
+    out = []
+    min_area = int(cfg.get('diff_min_area_px', 40))
+    for i in range(1, n):
+        x, y, w, h, area = st[i]
+        if area < min_area or w < 6 or h < 6:
+            continue
+        out.append(dict(kind='image_diff', x=x / W, y=y / H, w=w / W, h=h / H,
+                        px=[int(x), int(y), int(w), int(h)], area=int(area)))
+    info['components'] = len(out)
+    return out, info
+
+
+def is_duplicate_answer_image(qpath, apath, mark_rects, cfg=None):
+    """True when the answer image equals the question image except inside the answer marks."""
+    cfg = cfg or DEFAULTS
+    q, a, info = aligned_pair(qpath, apath, cfg)
+    if q is None:
+        return False, info
+    H, W = q.shape
+    d = cv2.absdiff(cv2.GaussianBlur(q, (3, 3), 0), cv2.GaussianBlur(a, (3, 3), 0))
+    m = (d > int(cfg.get('diff_threshold', 60))).astype(np.uint8)
+    keep = np.ones_like(m)
+    for r in mark_rects or []:
+        x0 = max(0, int((r['x'] - 0.01) * W)); y0 = max(0, int((r['y'] - 0.02) * H))
+        x1 = min(W, int((r['x'] + r['w'] + 0.01) * W) + 1); y1 = min(H, int((r['y'] + r['h'] + 0.02) * H) + 1)
+        keep[y0:y1, x0:x1] = 0
+    outside = float((m * keep).sum()) / float(max(1, keep.sum()))
+    info['changed_outside_marks'] = round(outside, 5)
+    limit = float(cfg.get('duplicate_max_outside_ratio', 0.004))
+    return outside <= limit, info
+
+
+# ---------------------------------------------------------------- controls
+
+def controls(path, cfg=None, thresholds=(200, 215, 230)):
+    """Small hollow round or square controls (radio buttons, check boxes). Normalized boxes.
+
+    Light grey controls are common, so several thresholds are tried and the
+    results are merged by centre.
+    """
+    cfg = cfg or DEFAULTS
+    g = _gray(path)
+    if g is None:
+        return []
+    H, W = g.shape
+    lo, hi = int(cfg.get('control_min_px', 8)), int(cfg.get('control_max_px', 30))
+    out = []
+    for thr in thresholds:
+        e = (g < thr).astype(np.uint8)
+        n, lab, st, _ = cv2.connectedComponentsWithStats(e, 8)
+        for i in range(1, n):
+            x, y, w, h, area = st[i]
+            if not (lo <= w <= hi and lo <= h <= hi) or abs(w - h) > max(2, 0.2 * max(w, h)):
+                continue
+            sub = (lab[y:y + h, x:x + w] == i)
+            core = sub[int(h * .3):int(h * .7) + 1, int(w * .3):int(w * .7) + 1].mean()
+            ring = sub[:, :max(2, w // 5)].any(axis=1).mean() > .3 and sub[:, -max(2, w // 5):].any(axis=1).mean() > .3
+            if core < 0.15 and ring and 0.15 < sub.mean() < 0.7:
+                c = dict(x=x / W, y=y / H, w=w / W, h=h / H, px=[int(x), int(y), int(w), int(h)])
+                cx, cy = _center(c)
+                if not any(abs(cx - _center(d)[0]) * W < 4 and abs(cy - _center(d)[1]) * H < 4 for d in out):
+                    out.append(c)
+    return out
+
+
+def _center(b):
+    return b['x'] + b['w'] / 2.0, b['y'] + b['h'] / 2.0
+
+
+# ---------------------------------------------------------------- Yes/No grid
+
+def _band_lines(path, y0_px, y1_px, scale=3):
+    """OCR one horizontal band of an image (psm 6). Word boxes are in full-image pixels."""
+    import subprocess, csv, io, shutil
+    g = _gray(path)
+    if g is None or not shutil.which('tesseract'):
+        return []
+    H, W = g.shape
+    y0 = max(0, int(y0_px)); y1 = min(H, int(y1_px) + 1)
+    if y1 - y0 < 4:
+        return []
+    crop = cv2.resize(g[y0:y1, :], None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC)
+    crop = cv2.copyMakeBorder(crop, 10, 10, 10, 10, cv2.BORDER_CONSTANT, value=255)
+    tmp = path + '.band.png'
+    cv2.imwrite(tmp, crop)
+    try:
+        r = subprocess.run(['tesseract', tmp, '-', '--psm', '6', 'tsv'], capture_output=True, text=True,
+                           encoding='utf-8', errors='replace', timeout=60)
+    finally:
+        try:
+            os.remove(tmp)
+        except OSError:
+            pass
+    words = []
+    for w in csv.DictReader(io.StringIO(r.stdout), delimiter='\t', quoting=csv.QUOTE_NONE):
+        if w.get('level') != '5' or not (w.get('text') or '').strip():
+            continue
+        x = (int(w['left']) - 10) / scale; y = (int(w['top']) - 10) / scale + y0
+        words.append(dict(t=w['text'], x=x, y=y, w=int(w['width']) / scale, h=int(w['height']) / scale,
+                          conf=float(w['conf'])))
+    return [dict(text=' '.join(z['t'] for z in words), words=words)] if words else []
+
+
+def _header_words(lines):
+    yes, no = [], []
+    for l in lines:
+        for w in l.get('words') or []:
+            t = _norm(w.get('t') or w.get('text'))
+            if t in YES_WORDS:
+                yes.append((l, w))
+            elif t in NO_WORDS:
+                no.append((l, w))
+    return yes, no
+
+
+def yes_no_layout(lines, qpath, W, H, cfg=None):
+    """Columns and rows of a Yes/No grid. Returns (layout or None, reason)."""
+    cfg = cfg or DEFAULTS
+    yes, no = _header_words(lines)
+    if not (yes and no) and qpath:
+        try:
+            import vision_util as V
+            extra, _, _ = V.ocr_lines_configured(qpath, psm=11, scale=3)
+        except Exception:
+            extra = []
+        y2, n2 = _header_words(extra)
+        yes = yes or y2
+        no = no or n2
+    if (yes or no) and not (yes and no) and qpath:
+        l0, w0 = (yes or no)[0]
+        y2, n2 = _header_words(_band_lines(qpath, w0['y'] - w0['h'], w0['y'] + 2 * w0['h']))
+        yes = yes or y2
+        no = no or n2
+    best = None
+    for ly, wy in yes:
+        for ln, wn in no:
+            yy = wy['y'] / H; yn = wn['y'] / H
+            if abs(yy - yn) > 0.04 or wy['x'] == wn['x']:
+                continue
+            if best is None or yy < best[0]:
+                best = (min(yy, yn), wy, wn, max((wy['y'] + wy['h']) / H, (wn['y'] + wn['h']) / H))
+    if best is None:
+        return None, 'Yes and No column headers were not found'
+    _, wy, wn, head_bottom = best
+    yx = (wy['x'] + wy['w'] / 2.0) / W
+    nx = (wn['x'] + wn['w'] / 2.0) / W
+    half = abs(yx - nx) / 2.0
+    cols = {'yes': yx, 'no': nx}
+    ctrls = [c for c in controls(qpath, cfg) if _center(c)[1] > head_bottom]
+    anchors = []
+    yes_c = sorted([c for c in ctrls if abs(_center(c)[0] - yx) < half], key=lambda c: c['y'])
+    no_c = sorted([c for c in ctrls if abs(_center(c)[0] - nx) < half], key=lambda c: c['y'])
+    for c in yes_c:
+        cy = _center(c)[1]
+        pair = [d for d in no_c if abs(_center(d)[1] - cy) < 0.03]
+        if len(pair) == 1:
+            anchors.append((cy + _center(pair[0])[1]) / 2.0)
+    ctrl_left = min([c['x'] for c in yes_c + no_c] or [min(yx, nx) - half])
+    left_edge = min(ctrl_left, min(yx, nx) - 0.5 * half) - 0.005
+    st_lines = [l for l in lines
+                if l['y'] >= head_bottom - 0.005 and l['x1'] < left_edge
+                and not is_ui_label(l['text'], cfg)]
+    if not st_lines:
+        return None, 'no statement text left of the Yes/No columns'
+    if len(anchors) != len(yes_c) or len(anchors) != len(no_c) or not anchors:
+        return None, 'radio controls under Yes and No do not pair up into rows (%s yes, %s no)' % (len(yes_c), len(no_c))
+    anchors.sort()
+    rows = [dict(id='r%d' % (i + 1), anchor=a, lines=[]) for i, a in enumerate(anchors)]
+    for l in sorted(st_lines, key=lambda z: (z['y'], z['x'])):
+        cy = (l['y'] + l['y1']) / 2.0
+        # a statement line belongs to the row whose anchor is the last one at or above
+        # the line (multi-line statements hang below their control), or the first row.
+        owner = None
+        for r in rows:
+            if r['anchor'] - 0.06 <= cy:
+                owner = r
+        owner = owner or rows[0]
+        owner['lines'].append(l)
+    for r in rows:
+        if not r['lines']:
+            return None, 'row %s has no statement text' % r['id']
+    bands = []
+    for i, r in enumerate(rows):
+        top = (rows[i - 1]['anchor'] + r['anchor']) / 2.0 if i else head_bottom
+        bot = (r['anchor'] + rows[i + 1]['anchor']) / 2.0 if i + 1 < len(rows) else 1.0
+        bands.append((top, bot))
+    out_rows = []
+    for r, band in zip(rows, bands):
+        out_rows.append(dict(
+            id=r['id'],
+            text=' '.join(l['text'] for l in r['lines']),
+            minconf=int(min(l['minconf'] for l in r['lines'])),
+            band=[round(band[0], 4), round(band[1], 4)],
+        ))
+    layout = dict(kind='yes_no_grid', columns=cols, column_half_width=round(half, 4),
+                  header_bottom=round(head_bottom, 4), rows=out_rows,
+                  controls=[dict(x=round(c['x'], 4), y=round(c['y'], 4), w=round(c['w'], 4), h=round(c['h'], 4)) for c in yes_c + no_c])
+    return layout, None
+
+
+def grid_key(marks, layout):
+    """Key from one method's marks, scoped to grid cells. Returns (key or None, detail)."""
+    cells = {}
+    outside = 0
+    for m in marks or []:
+        cx, cy = _center(m)
+        col = None
+        for cid, x in layout['columns'].items():
+            if abs(cx - x) <= layout['column_half_width']:
+                col = cid
+        row = None
+        for r in layout['rows']:
+            if r['band'][0] <= cy < r['band'][1]:
+                row = r['id']
+        if col is None or row is None:
+            outside += 1
+            continue
+        cells.setdefault(row, set()).add(col)
+    detail = {'marks_in_cells': sum(len(v) for v in cells.values()), 'marks_outside': outside}
+    rows = [r['id'] for r in layout['rows']]
+    if set(cells) != set(rows) or any(len(v) != 1 for v in cells.values()):
+        detail['reason'] = 'not exactly one marked cell in every row'
+        return None, detail
+    return {rid: next(iter(cells[rid])) for rid in rows}, detail
+
+
+# ---------------------------------------------------------------- drop-down lists
+
+def list_boxes(path, thresholds=(200, 230)):
+    """Bordered rectangles that hold drop-down choices. Normalized (x, y, w, h).
+
+    A rectangle is kept when at least three of its four sides are mostly dark at
+    one of the thresholds (light grey borders are common in screenshots).
+    """
+    g = _gray(path)
+    if g is None:
+        return []
+    H, W = g.shape
+    found = []
+    for thr in thresholds:
+        e = (g < thr).astype(np.uint8)
+        cs, _ = cv2.findContours(e, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)
+        for c in cs:
+            x, y, w, h = cv2.boundingRect(c)
+            if w < 60 or h < 30 or w > 0.99 * W or h > 0.95 * H:
+                continue
+            sides = [e[y:y + 2, x:x + w].max(axis=0).mean(), e[y + h - 2:y + h, x:x + w].max(axis=0).mean(),
+                     e[y:y + h, x:x + 2].max(axis=1).mean(), e[y:y + h, x + w - 2:x + w].max(axis=1).mean()]
+            if sorted(sides)[1] < 0.75:
+                continue
+            found.append((x / W, y / H, w / W, h / H))
+    ded = []
+    for r in sorted(found, key=lambda r: r[2] * r[3]):
+        if not any(abs(r[0] - d[0]) < .01 and abs(r[1] - d[1]) < .02 and abs(r[2] - d[2]) < .02 and abs(r[3] - d[3]) < .03 for d in ded):
+            ded.append(r)
+    return ded
+
+
+BORDER_GLYPHS = ('|', '[', ']', 'l|', '|l')
+
+
+def _clean_choice(line, box, W):
+    """Drop list-border glyphs that OCR reads as '|' at the left or right edge of the box."""
+    bx, by, bw, bh = box
+    words = list(line.get('words') or [])
+    dropped = []
+    keep = []
+    for w in words:
+        t = (w.get('t') or '').strip()
+        x0 = w['x'] / W; x1 = (w['x'] + w['w']) / W
+        at_edge = abs(x0 - bx) < 0.02 or abs(x1 - (bx + bw)) < 0.02
+        if t in BORDER_GLYPHS and at_edge:
+            dropped.append(t)
+            continue
+        keep.append(w)
+    if not dropped:
+        return line, []
+    new = dict(line)
+    new['words'] = keep
+    new['text'] = ' '.join(w['t'] for w in keep)
+    if keep:
+        new['minconf'] = min(w['conf'] for w in keep)
+        new['x'] = min(w['x'] for w in keep) / W
+    return new, dropped
+
+
+def dropdown_layout(lines, qpath, cfg=None):
+    cfg = cfg or DEFAULTS
+    g = _gray(qpath)
+    W = g.shape[1] if g is not None else 1
+    boxes = list_boxes(qpath)
+    lists = []
+    for (bx, by, bw, bh) in boxes:
+        inside = [l for l in lines
+                  if bx - 0.005 <= (l['x'] + l['x1']) / 2.0 <= bx + bw + 0.005
+                  and by <= (l['y'] + l['y1']) / 2.0 <= by + bh]
+        if len(inside) >= 2:
+            lists.append(dict(box=(bx, by, bw, bh), lines=sorted(inside, key=lambda z: z['y']), src=inside))
+    # keep the innermost box when boxes nest around the same lines
+    lists.sort(key=lambda d: d['box'][2] * d['box'][3])
+    kept = []
+    used = set()
+    for d in lists:
+        ids = {id(l) for l in d['lines']}
+        if ids & used:
+            continue
+        used |= ids
+        kept.append(d)
+    if not kept:
+        return None, 'no bordered drop-down list was found'
+    kept.sort(key=lambda d: (round(d['box'][1], 2), d['box'][0]))
+    in_lists = {id(l) for d in kept for l in d['lines']}
+    border = []
+    for d in kept:
+        cleaned = []
+        for l in d['lines']:
+            nl, dropped = _clean_choice(l, d['box'], W)
+            border.extend(dropped)
+            if (nl.get('text') or '').strip():
+                cleaned.append(nl)
+        d['lines'] = cleaned
+    blanks = []
+    for i, d in enumerate(kept):
+        bx, by, bw, bh = d['box']
+        lh = max(0.01, min(l['y1'] - l['y'] for l in d['lines']))
+        combo = (bx, by - 2.2 * lh, bw, 2.2 * lh)
+        blanks.append(dict(id='blank%d' % (i + 1), box=[round(v, 4) for v in d['box']],
+                           combo=[round(v, 4) for v in combo],
+                           choices=[l['text'] for l in d['lines']],
+                           choice_boxes=[[l['x'], l['y'], l['x1'], l['y1']] for l in d['lines']],
+                           minconf=int(min(l['minconf'] for l in d['lines']))))
+    chrome = []
+    prompt = []
+    H = g.shape[0] if g is not None else 1
+    pieces = []
+    for l in lines:
+        if id(l) in in_lists:
+            continue
+        l, glyphs = _strip_combo_glyphs(l, blanks, W, H)
+        chrome.extend(glyphs)
+        if not (l.get('text') or '').strip():
+            continue
+        pieces.extend(_split_at_combos(l, blanks, W, H))
+    for l in pieces:
+        cx, cy = (l['x'] + l['x1']) / 2.0, (l['y'] + l['y1']) / 2.0
+        if is_ui_label(l['text'], cfg):
+            chrome.append(l['text'])
+            continue
+        in_combo = any(b['combo'][0] <= cx <= b['combo'][0] + b['combo'][2]
+                       and b['combo'][1] <= cy <= b['combo'][1] + b['combo'][3] for b in blanks)
+        if in_combo and len(_norm(l['text'])) <= 2:
+            chrome.append(l['text'])
+            continue
+        prompt.append(l)
+    segments = _segments(prompt, blanks)
+    for b in blanks:
+        if len(b['choices']) < 2:
+            return None, 'drop-down list %s has fewer than two readable choices' % b['id']
+    return dict(kind='dropdown_lists', blanks=blanks, prompt_lines=[l['text'] for l in prompt],
+                segments=segments, chrome=chrome, border_glyphs=border), None
+
+
+def _split_at_combos(line, blanks, W, H):
+    """A text line read across a closed drop-down box is two lines: the words
+    left of the box and the words right of it."""
+    words = line.get('words') or []
+    if not words or not W or not H:
+        return [line]
+    cy = (line['y'] + line['y1']) / 2.0
+    for b in blanks:
+        x0, y0, bw, bh = b['combo']
+        if not (y0 - 0.01 <= cy <= y0 + bh + 0.01):
+            continue
+        left = [w for w in words if (w['x'] + w['w'] / 2.0) / W < x0]
+        right = [w for w in words if (w['x'] + w['w'] / 2.0) / W > x0 + bw]
+        if left and right and len(left) + len(right) == len(words):
+            out = []
+            for part in (left, right):
+                nl = dict(line)
+                nl['words'] = part
+                nl['text'] = ' '.join(w['t'] for w in part)
+                nl['x'] = min(w['x'] for w in part) / W
+                nl['x1'] = max(w['x'] + w['w'] for w in part) / W
+                nl['minconf'] = min(w['conf'] for w in part)
+                out.append(nl)
+            return out
+    return [line]
+
+
+def _strip_combo_glyphs(line, blanks, W, H):
+    """Remove arrow and border glyphs (two characters or fewer) that OCR read
+    inside a closed drop-down box, and recompute the line box."""
+    words = line.get('words') or []
+    if not words or not W or not H:
+        return line, []
+    keep, dropped = [], []
+    for w in words:
+        cx = (w['x'] + w['w'] / 2.0) / W
+        cy = (w['y'] + w['h'] / 2.0) / H
+        t = w.get('t') or ''
+        in_combo = any(b['combo'][0] - 0.005 <= cx <= b['combo'][0] + b['combo'][2] + 0.005
+                       and b['combo'][1] - 0.005 <= cy <= b['combo'][1] + b['combo'][3] + 0.005 for b in blanks)
+        if in_combo and len(_norm(t).replace(' ', '')) <= 2:
+            dropped.append(t)
+        else:
+            keep.append(w)
+    if not dropped:
+        return line, []
+    new = dict(line)
+    new['words'] = keep
+    new['text'] = ' '.join(w['t'] for w in keep)
+    if keep:
+        new['x'] = min(w['x'] for w in keep) / W
+        new['x1'] = max(w['x'] + w['w'] for w in keep) / W
+        new['minconf'] = min(w['conf'] for w in keep)
+    return new, dropped
+
+
+def _segments(prompt, blanks):
+    """Reading order of sentence text and blanks.
+
+    Each blank is level with one text line L (the line left of the closed box
+    whose centre is nearest the box centre). Text right of the box on L puts
+    the blank between the two parts. Otherwise the blank goes after L, or, when
+    L does not end a sentence and the next lines continue the same paragraph
+    (same left edge, normal line spacing, no blank of their own), after the
+    last of those lines.
+    """
+    order = sorted(prompt, key=lambda l: (round((l['y'] + l['y1']) / 2.0, 2), l['x']))
+    cyl = lambda l: (l['y'] + l['y1']) / 2.0
+    level = {}
+    inline_right = {}
+    for b in blanks:
+        cx0, cy0, cw, ch = b['combo']
+        cy = cy0 + ch / 2.0
+        left = [l for l in order if l['x1'] <= cx0 + 0.01 and abs(cyl(l) - cy) < max(ch, 0.03)]
+        right = [l for l in order if l['x'] >= cx0 + cw - 0.01 and abs(cyl(l) - cy) < max(ch, 0.03)]
+        L = min(left, key=lambda l: abs(cyl(l) - cy)) if left else None
+        level[b['id']] = L
+        if L is not None and right:
+            R = min(right, key=lambda l: abs(cyl(l) - cy))
+            if abs(cyl(R) - cyl(L)) < 0.6 * (L['y1'] - L['y']):
+                inline_right[b['id']] = R
+    starts = {}
+    for b in blanks:
+        cx0, cy0, cw, ch = b['combo']
+        cy = cy0 + ch / 2.0
+        if level[b['id']] is None:
+            right = [l for l in order if l['x'] >= cx0 + cw - 0.01 and abs(cyl(l) - cy) < max(ch, 0.03)]
+            if right:
+                # the sentence starts with the blank: it goes before the text on its right
+                starts[b['id']] = min(right, key=lambda l: abs(cyl(l) - cy))
+    owned = {id(l) for l in level.values() if l is not None}
+    placed = {}
+    before = {}
+    for b in blanks:
+        L = level[b['id']]
+        if L is None and b['id'] in starts:
+            before.setdefault(id(starts[b['id']]), []).append(b['id'])
+            continue
+        if L is None:
+            placed.setdefault(None, []).append(b['id'])
+            continue
+        if b['id'] in inline_right:
+            placed.setdefault(id(L), []).append(b['id'])
+            continue
+        end = L
+        i = order.index(L)
+        while i + 1 < len(order) and not re.search(r'[.:;?!]\s*$', end['text'] or ''):
+            nxt = order[i + 1]
+            lh = max(end['y1'] - end['y'], nxt['y1'] - nxt['y'])
+            if id(nxt) in owned or abs(nxt['x'] - L['x']) > 0.03 or nxt['y'] - end['y1'] > 1.2 * lh:
+                break
+            end = nxt
+            i += 1
+        placed.setdefault(id(end), []).append(b['id'])
+    segs = []
+    for l in order:
+        for bid in before.get(id(l), []):
+            segs.append({'blank': bid})
+        segs.append({'text': l['text']})
+        for bid in placed.get(id(l), []):
+            segs.append({'blank': bid})
+    for bid in placed.get(None, []):
+        segs.append({'blank': bid})
+    return segs
+
