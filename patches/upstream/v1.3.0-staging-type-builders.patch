+def _has_lettered_options(item):
+    opts = item.get('options') or {}
+    return bool(opts)
+
+
+def _split_accepted(text):
+    """Split an answer line into accepted strings. Commas only split when they
+    separate short alternatives, not a single phrase."""
+    text = (text or '').strip()
+    if not text:
+        return []
+    parts = re.split(r'\s*;\s*|\s*\|\s*', text)
+    out = []
+    for p in parts:
+        p = p.strip().strip('.')
+        if p:
+            out.append(p)
+    return out
+
+
+def parse_text_cloze(item):
+    """Typed blanks in the stem. Returns (structure, reason)."""
+    if _has_lettered_options(item):
+        return None, 'text cloze item also has lettered options'
+    stem = item.get('stem') or ''
+    raw = (item.get('answer_raw') or '').strip()
+    blanks = list(BLANK_TOKEN.finditer(stem))
+    if not blanks:
+        return None, 'text cloze stem has no blank (______ or [blank])'
+    answers = _cloze_answers(raw, len(blanks))
+    if answers is None:
+        return None, 'text cloze answer line does not give a value for every blank'
+    segs = []
+    last = 0
+    ids = []
+    for i, m in enumerate(blanks):
+        before = stem[last:m.start()]
+        if before:
+            segs.append({'text': before})
+        bid = 'blank%d' % (i + 1)
+        segs.append({'blank': bid})
+        ids.append(bid)
+        last = m.end()
+    after = stem[last:]
+    if after:
+        segs.append({'text': after})
+    # Instruction is the full sentences before the first blank. A dangling
+    # word such as "A" right before ______ stays in the cloze segments only.
+    intro = stem[:blanks[0].start()].rstrip()
+    if '.' in intro:
+        head, tail = intro.rsplit('.', 1)
+        if tail.strip():
+            intro = head.strip() + '.'
+    intro = intro.strip() or ' '
+    return {
+        'type': 'text_cloze',
+        'intro': intro,
+        'segments': segs,
+        'blanks': [{'id': bid, 'label': bid, 'kind': 'text'} for bid in ids],
+        'key': {bid: answers[i] for i, bid in enumerate(ids)},
+    }, None
+
+
+def _cloze_answers(raw, n):
+    """Parse n blank values from the answer line, or None if not exact."""
+    raw = (raw or '').strip()
+    if not raw:
+        return None
+    numbered = re.findall(
+        r'(?:^|[,;\s])(?:blank\s*)?(\d{1,2})[.:)\-]\s*(.+?)(?=(?:[,;\s]+(?:blank\s*)?\d{1,2}[.:)\-]|\s*$))',
+        raw, re.I)
+    if numbered:
+        by = {}
+        for num, val in numbered:
+            val = val.strip().strip('.,;')
+            if not val or int(num) in by:
+                return None
+            by[int(num)] = val
+        if set(by) != set(range(1, n + 1)):
+            return None
+        return [by[i] for i in range(1, n + 1)]
+    labelled = re.findall(r'blank\s*(\d{1,2})\s*[:=]\s*([^;]+)', raw, re.I)
+    if labelled:
+        by = {}
+        for num, val in labelled:
+            val = val.strip().strip('.,;')
+            if not val or int(num) in by:
+                return None
+            by[int(num)] = val
+        if set(by) != set(range(1, n + 1)):
+            return None
+        return [by[i] for i in range(1, n + 1)]
+    parts = _split_accepted(raw)
+    if len(parts) == n and all(parts):
+        return parts
+    if n == 1 and raw:
+        return [raw.strip().strip('.')]
+    return None
+
+
+def parse_short_text(item):
+    """A short typed answer. Returns (structure, reason)."""
+    if _has_lettered_options(item):
+        return None, 'short text item also has lettered options'
+    raw = (item.get('answer_raw') or '').strip()
+    if not raw:
+        return None, 'short text has no answer in the PDF'
+    stem = item.get('stem') or ''
+    accepted = []
+    m = re.search(r'(?i)also accept(?:ed)?\s*:\s*(.*)$', raw)
+    if m:
+        main = raw[:m.start()].strip().strip('()')
+        if main:
+            accepted.extend(_split_accepted(main) or [main.strip().strip('.')])
+        rest = m.group(1).strip().strip('()')
+        accepted.extend(_split_accepted(rest) or ([rest] if rest else []))
+    else:
+        accepted = _split_accepted(raw) or [raw.strip().strip('.')]
+    seen = set()
+    clean = []
+    for a in accepted:
+        a = (a or '').strip().strip('.')
+        if a and a.lower() not in seen:
+            seen.add(a.lower())
+            clean.append(a)
+    if not clean:
+        return None, 'short text has no answer in the PDF'
+    match = 'text'
+    if re.search(r'(?i)\b(?:match as an expression|as an expression)\b', stem):
+        match = 'expression'
+    if re.search(r'(?i)\b(?:as a number|match as a number)\b', stem):
+        match = 'number'
+    return {'type': 'short_text', 'key': {'accepted': clean, 'match': match}}, None
+
+
+def _parse_number_unit(text):
+    """Return (number text, unit or '') from a phrase, or (None, '')."""
+    text = (text or '').strip()
+    if not text:
+        return None, ''
+    m = re.search(
+        r'(?i)([-+]?(?:\d+/\d+|\d+(?:\.\d+)?|\.\d+)(?:[eE][-+]?\d+)?)'
+        r'(?:\s*([A-Za-z%][A-Za-z0-9%/^*]*))?',
+        text,
+    )
+    if not m:
+        return None, ''
+    unit = (m.group(2) or '').strip()
+    known = {'ms', 's', 'sec', 'secs', 'seconds', 'm', 'mm', 'cm', 'km',
+             'g', 'kg', 'mb', 'gb', 'tb', 'kb', 'hz', 'khz', 'mhz', 'ghz',
+             'percent', 'pct', '%'}
+    if unit.lower() in known:
+        pass
+    elif unit and re.fullmatch(r'[A-Za-z]{1,8}%?|[A-Za-z]{1,4}/[A-Za-z]{1,4}', unit):
+        pass
+    else:
+        unit = ''
+    return m.group(1), unit
+
+
+_NUM = r'[-+]?(?:\d+/\d+|\d+(?:\.\d+)?|\.\d+)(?:[eE][-+]?\d+)?'
+
+
+def parse_numeric(item):
+    """A numeric value or range from the answer line. Returns (structure, reason)."""
+    if _has_lettered_options(item):
+        return None, 'numeric item also has lettered options'
+    raw = (item.get('answer_raw') or '').strip()
+    stem = item.get('stem') or ''
+    if not raw:
+        return None, 'numeric item has no number in the answer line'
+    key = {}
+    range_m = re.search(
+        r'(?i)(?:range\s+)?(%s)\s+(?:to|\.\.+ )\s+(%s)' % (_NUM, _NUM),
+        raw,
+    )
+    if range_m:
+        key['range'] = [range_m.group(1), range_m.group(2)]
+    value, unit = _parse_number_unit(raw)
+    if value is not None and 'range' not in key:
+        key['value'] = value
+        if unit:
+            key['unit'] = unit
+    if 'value' not in key and 'range' not in key:
+        return None, 'numeric item has no number in the answer line'
+    if 'unit' not in key:
+        um = re.search(r'(?i)\bunit(?: is)?\s*:?\s*([A-Za-z%][A-Za-z0-9%/^*]{0,15})', stem)
+        if um:
+            key['unit'] = um.group(1)
+    tm = re.search(
+        r'(?i)(?:accepted\s+)?tolerance(?:\s+is)?\s*:?\s*(%s)'
+        r'|plus or minus\s*(%s)'
+        r'|\+/-\s*(%s)' % (_NUM, _NUM, _NUM),
+        stem + ' ' + raw,
+    )
+    if tm:
+        key['tolerance'] = next(g for g in tm.groups() if g)
+        if re.search(r'(?i)\brelative\b', stem):
+            key['tolerance_type'] = 'relative'
+        else:
+            key['tolerance_type'] = 'absolute'
+    return {'type': 'numeric', 'key': key}, None
