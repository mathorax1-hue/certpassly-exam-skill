+def grid_key_multi(marks, layout):
+    """Key when a row may have more than one marked column.
+
+    Returns ({row: [col, ...]} or None, detail). Every row needs at least one
+    mark. Column ids in each row are sorted by their numeric suffix.
+    """
+    cells = {}
+    outside = 0
+    for m in marks or []:
+        cx, cy = _center(m)
+        col = None
+        for cid, x in layout['columns'].items():
+            if abs(cx - x) <= layout['column_half_width']:
+                col = cid
+        row = None
+        for r in layout['rows']:
+            if r['band'][0] <= cy < r['band'][1]:
+                row = r['id']
+        if col is None or row is None:
+            outside += 1
+            continue
+        cells.setdefault(row, set()).add(col)
+    detail = {'marks_in_cells': sum(len(v) for v in cells.values()), 'marks_outside': outside}
+    rows = [r['id'] for r in layout['rows']]
+    if set(cells) != set(rows) or any(len(v) < 1 for v in cells.values()):
+        detail['reason'] = 'not at least one marked cell in every row'
+        return None, detail
+
+    def col_sort(c):
+        m = re.search(r'(\d+)$', c)
+        return (0, int(m.group(1))) if m else (1, c)
+
+    return {rid: sorted(cells[rid], key=col_sort) for rid in rows}, detail
+
