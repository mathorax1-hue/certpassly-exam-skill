+def item(stem, answer, options=None, key='q001', source=None):
+    rec = {
+        'question_key': key,
+        'stem': stem,
+        'answer_raw': answer,
+        'options': options or {},
+        'source_text': source or (stem + '\nCorrect Answer: ' + answer),
+        'source_number': 1,
+    }
+    return rec
+
+
+class ParserTests(unittest.TestCase):
+    def test_text_cloze_reads_every_blank(self):
+        st, why = TS.parse_text_cloze(item(
+            'Type the missing word in each blank. A ______ stores objects in buckets. A ______ forwards packets.',
+            '1. object 2. router'))
+        self.assertIsNone(why)
+        self.assertEqual(st['type'], 'text_cloze')
+        self.assertEqual(st['key'], {'blank1': 'object', 'blank2': 'router'})
+        self.assertEqual(st['intro'], 'Type the missing word in each blank.')
+        self.assertEqual([b['kind'] for b in st['blanks']], ['text', 'text'])
+
+    def test_text_cloze_holds_when_a_blank_has_no_answer(self):
+        st, why = TS.parse_text_cloze(item(
+            'Type the missing word in each blank. A ______ stores objects. A ______ forwards packets.',
+            '1. object'))
+        self.assertIsNone(st)
+        self.assertIn('every blank', why)
+
+    def test_short_text_reads_accepted_list(self):
+        st, why = TS.parse_short_text(item(
+            'Type a short answer in the box. What protocol assigns addresses automatically?',
+            'DHCP (also accept: Dynamic Host Configuration Protocol)'))
+        self.assertIsNone(why)
+        self.assertEqual(st['key']['accepted'], ['DHCP', 'Dynamic Host Configuration Protocol'])
+        self.assertEqual(st['key']['match'], 'text')
+
+    def test_short_text_holds_without_an_answer(self):
+        st, why = TS.parse_short_text(item(
+            'Type a short answer in the box. What is the name of the protocol?', ''))
+        self.assertIsNone(st)
+        self.assertIn('no answer', why)
+
+    def test_numeric_reads_value_unit_and_tolerance(self):
+        st, why = TS.parse_numeric(item(
+            'Enter the number. The accepted tolerance is 0.5. The unit is ms. What is the delay?',
+            '10 ms'))
+        self.assertIsNone(why)
+        self.assertEqual(st['key']['value'], '10')
+        self.assertEqual(st['key']['unit'], 'ms')
+        self.assertEqual(st['key']['tolerance'], '0.5')
+        self.assertEqual(st['key']['tolerance_type'], 'absolute')
+
+    def test_numeric_holds_non_number_answer(self):
+        st, why = TS.parse_numeric(item(
+            'Enter the number. What is the delay?', 'about ten'))
+        self.assertIsNone(st)
+        self.assertIn('no number', why)
+
+    def test_does_not_steal_lettered_items(self):
+        rec = item('Type a short answer in the box. Which protocol is this?', 'A',
+                   options={'A': 'DHCP', 'B': 'DNS'})
+        st, why = TS.parse_short_text(rec)
+        self.assertIsNone(st)
+        self.assertIn('lettered', why)
