diff --git a/scripts/ai_vision_groq.py b/scripts/ai_vision_groq.py
new file mode 100644
index 0000000..efa70cc
--- /dev/null
+++ b/scripts/ai_vision_groq.py
@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Groq vision provider for OCR-held items. The API key is never logged."""
+from __future__ import annotations
+
+import base64
+import json
+import os
+import time
+import urllib.error
+import urllib.request
+
+DEFAULT_API_URL = 'https://api.groq.com/openai/v1/chat/completions'
+DEFAULT_MODEL = 'qwen/qwen3.8-27b'
+DEFAULT_USER_AGENT = 'certpassly-exam-pipeline/1.3.0'
+TRANSCRIBE_PROMPT = (
+    'Transcribe every visible character in the image(s) exactly as written. '
+    'Include line numbers, punctuation, spacing, symbols, and typographic marks as they appear. '
+    'Do not correct, complete, translate, or explain the text. '
+    'Do not add words that are not visible. '
+    'If there are several images, transcribe them in order, separated by a blank line. '
+    'Return only the transcription.'
+)
+
+
+def api_key_from_env():
+    """Read GROQ_API_KEY from the environment. Never log the value."""
+    raw = os.environ.get('GROQ_API_KEY')
+    if raw is None:
+        return None
+    key = str(raw).strip()
+    return key or None
+
+
+class CallBudget:
+    """Per-run cap on provider HTTP calls."""
+
+    def __init__(self, max_calls=50):
+        try:
+            self.max_calls = int(max_calls)
+        except (TypeError, ValueError):
+            self.max_calls = 50
+        if self.max_calls < 0:
+            self.max_calls = 0
+        self.used = 0
+
+    def remaining(self):
+        return max(0, self.max_calls - self.used)
+
+    def allow(self):
+        if self.used >= self.max_calls:
+            return False
+        self.used += 1
+        return True
+
+
+def image_to_data_uri(path):
+    if not path or not os.path.isfile(path):
+        return None
+    ext = os.path.splitext(path)[1].lower()
+    mime = {'.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
+            '.gif': 'image/gif', '.webp': 'image/webp'}.get(ext, 'image/png')
+    with open(path, 'rb') as fh:
+        blob = fh.read()
+    if not blob:
+        return None
+    return 'data:%s;base64,%s' % (mime, base64.b64encode(blob).decode('ascii'))
+
+
+def build_payload(image_paths, cfg=None):
+    cfg = cfg or {}
+    model = cfg.get('model') or DEFAULT_MODEL
+    try:
+        temperature = float(cfg.get('temperature', 0))
+    except (TypeError, ValueError):
+        temperature = 0.0
+    prompt = cfg.get('prompt') or TRANSCRIBE_PROMPT
+    content = [{'type': 'text', 'text': prompt}]
+    used = []
+    for path in image_paths or []:
+        uri = image_to_data_uri(path)
+        if not uri:
+            continue
+        content.append({'type': 'image_url', 'image_url': {'url': uri}})
+        used.append(path)
+    if len(content) == 1:
+        return None, used
+    payload = {
+        'model': model,
+        'temperature': temperature,
+        'messages': [{'role': 'user', 'content': content}],
+    }
+    return payload, used
+
+
+def post_json(url, headers, payload, timeout):
+    data = json.dumps(payload).encode('utf-8')
+    req = urllib.request.Request(url, data=data, headers=headers, method='POST')
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            body = resp.read().decode('utf-8', errors='replace')
+            status = getattr(resp, 'status', None) or resp.getcode()
+            return int(status), json.loads(body) if body else {}
+    except urllib.error.HTTPError as exc:
+        raw = exc.read().decode('utf-8', errors='replace') if exc.fp else ''
+        try:
+            parsed = json.loads(raw) if raw else {}
+        except json.JSONDecodeError:
+            parsed = {}
+        return int(exc.code), parsed
+
+
+def _message_text(body):
+    if not isinstance(body, dict):
+        return ''
+    choices = body.get('choices') or []
+    if not choices or not isinstance(choices[0], dict):
+        return ''
+    msg = choices[0].get('message') or {}
+    text = msg.get('content')
+    if isinstance(text, list):
+        parts = []
+        for part in text:
+            if isinstance(part, dict) and part.get('text'):
+                parts.append(part['text'])
+            elif isinstance(part, str):
+                parts.append(part)
+        return '\n'.join(parts).strip()
+    return str(text or '').strip()
+
+
+def _redact(text, key):
+    """Drop any accidental copy of the key from a string we might log."""
+    if not text or not key:
+        return text
+    return str(text).replace(key, '[redacted]')
+
+
+def transcribe_item(item, image_paths, cfg=None, post=None, budget=None, key=None):
+    """Call Groq once for an item. Returns a read dict or a skipped/error dict.
+
+    The API key is never included in the return value or in log fields.
+    """
+    cfg = cfg or {}
+    key = key if key is not None else api_key_from_env()
+    started = time.time()
+    request_time = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
+    model = cfg.get('model') or DEFAULT_MODEL
+    out = {
+        'question_key': (item or {}).get('question_key'),
+        'source': 'groq',
+        'provider': 'groq',
+        'model': model,
+        'request_time': request_time,
+        'image_sha256': '',
+        'transcribed_text': '',
+    }
+    if not key:
+        out['skip_reason'] = 'GROQ_API_KEY is not set'
+        out['duration_ms'] = int((time.time() - started) * 1000)
+        return out
+    if budget is not None and not budget.allow():
+        out['skip_reason'] = 'AI vision call cap reached'
+        out['duration_ms'] = int((time.time() - started) * 1000)
+        return out
+    payload, used = build_payload(image_paths, cfg)
+    if not payload:
+        out['skip_reason'] = 'no readable images for Groq'
+        out['duration_ms'] = int((time.time() - started) * 1000)
+        return out
+    from ocr_retry import file_sha256
+    out['image_sha256'] = ' | '.join(
+        '%s:%s' % (os.path.basename(p), file_sha256(p) or '') for p in used)
+    url = cfg.get('api_url') or DEFAULT_API_URL
+    try:
+        timeout = float(cfg.get('timeout_seconds') or 60)
+    except (TypeError, ValueError):
+        timeout = 60.0
+    try:
+        max_retries = int(cfg.get('max_retries') or 2)
+    except (TypeError, ValueError):
+        max_retries = 2
+    headers = {
+        'Authorization': 'Bearer ' + key,
+        'Content-Type': 'application/json',
+        'User-Agent': cfg.get('user_agent') or DEFAULT_USER_AGENT,
+    }
+    poster = post or post_json
+    last_status = None
+    last_error = None
+    attempts = max(1, max_retries + 1)
+    for i in range(attempts):
+        try:
+            status, body = poster(url, headers, payload, timeout)
+        except Exception as exc:
+            last_error = _redact(str(exc), key)
+            last_status = None
+            if i + 1 < attempts:
+                time.sleep(min(2 ** i, 8))
+            continue
+        last_status = status
+        if status == 200:
+            text = _message_text(body)
+            out['transcribed_text'] = text
+            out['http_status'] = status
+            out['attempts'] = i + 1
+            out['duration_ms'] = int((time.time() - started) * 1000)
+            if budget is not None:
+                out['groq_call_index'] = budget.used
+            if not text:
+                out['skip_reason'] = 'Groq returned an empty transcription'
+            return out
+        # Retry transient failures only. Do not retry 401/403/400.
+        last_error = 'HTTP %s' % status
+        if status in (401, 403, 400, 404, 413, 422):
+            break
+        if i + 1 < attempts:
+            time.sleep(min(2 ** i, 8))
+    out['http_status'] = last_status
+    out['attempts'] = attempts
+    out['skip_reason'] = last_error or 'Groq request failed'
+    out['duration_ms'] = int((time.time() - started) * 1000)
+    if budget is not None:
+        out['groq_call_index'] = budget.used
+    return out
