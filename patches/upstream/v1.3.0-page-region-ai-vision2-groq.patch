+#!/usr/bin/env python3
+"""Groq AI vision provider tests. HTTP is mocked. No live calls and no real keys."""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import cv2
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'scripts'))
+
+import ai_vision as AI
+import ai_vision_groq as G
+
+
+def _png(path, w=40, h=20):
+    img = np.full((h, w, 3), 240, dtype=np.uint8)
+    cv2.imwrite(str(path), img)
+
+
+class FakeHttp:
+    def __init__(self, responses):
+        self.responses = list(responses)
+        self.calls = []
+
+    def __call__(self, url, headers, payload, timeout):
+        rec = {
+            'url': url,
+            'header_names': sorted(headers.keys()),
+            'has_authorization': 'Authorization' in headers,
+            'authorization_prefix': (headers.get('Authorization') or '')[:6],
+            'user_agent': headers.get('User-Agent'),
+            'model': (payload or {}).get('model'),
+            'temperature': (payload or {}).get('temperature'),
+            'timeout': timeout,
+            'n_images': 0,
+        }
+        for msg in (payload or {}).get('messages') or []:
+            for part in msg.get('content') or []:
+                if isinstance(part, dict) and part.get('type') == 'image_url':
+                    rec['n_images'] += 1
+                    uri = ((part.get('image_url') or {}).get('url') or '')
+                    rec['data_uri_prefix'] = uri[:22]
+        # Never keep the raw Authorization value in the call log.
+        self.calls.append(rec)
+        if not self.responses:
+            return 500, {}
+        item = self.responses.pop(0)
+        if isinstance(item, Exception):
+            raise item
+        return item
+
+
+class VisionConfigTests(unittest.TestCase):
+    def test_defaults_stay_off(self):
+        with mock.patch.dict(os.environ, {}, clear=False):
+            for name in (
+                'CERTPASSLY_AI_VISION_ENABLED', 'CERTPASSLY_AI_VISION_PROVIDER',
+                'CERTPASSLY_AI_VISION_MODEL', 'CERTPASSLY_USE_COMMITTED_AI_READS',
+            ):
+                os.environ.pop(name, None)
+            cfg = AI.vision_config({'ai_vision': {}})
+        self.assertFalse(cfg['enabled'])
+        self.assertEqual(cfg['provider'], 'none')
+        self.assertEqual(cfg['model'], 'qwen/qwen3.8-27b')
+        self.assertEqual(cfg['temperature'], 0)
+        self.assertEqual(cfg['max_calls_per_run'], 50)
+        self.assertTrue(cfg['use_committed_reads'])
+
+    def test_env_enables_groq_and_ignores_committed_reads(self):
+        env = {
+            'CERTPASSLY_AI_VISION_ENABLED': 'true',
+            'CERTPASSLY_AI_VISION_PROVIDER': 'groq',
+            'CERTPASSLY_AI_VISION_MODEL': 'qwen/qwen3.8-27b',
+            'CERTPASSLY_USE_COMMITTED_AI_READS': 'false',
+        }
+        with mock.patch.dict(os.environ, env, clear=False):
+            cfg = AI.vision_config({'ai_vision': {'enabled': False, 'provider': 'none'}})
+        self.assertTrue(cfg['enabled'])
+        self.assertEqual(cfg['provider'], 'groq')
+        self.assertFalse(cfg['use_committed_reads'])
+
+
+class GroqProviderTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.dir = Path(self.tmp.name)
+        self.img = self.dir / 'crop.png'
+        _png(self.img)
+        self.item = {'question_key': 'q003', 'question_images': ['q003-1.png']}
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_successful_transcription_uses_data_uri_and_user_agent(self):
+        body = {'choices': [{'message': {'content': 'visible text from the crop'}}]}
+        http = FakeHttp([(200, body)])
+        out = G.transcribe_item(
+            self.item, [str(self.img)],
+            {'model': 'qwen/qwen3.8-27b', 'temperature': 0, 'timeout_seconds': 15, 'max_retries': 0},
+            post=http, budget=G.CallBudget(50), key='test-key-not-real')
+        self.assertEqual(out['transcribed_text'], 'visible text from the crop')
+        self.assertEqual(out['model'], 'qwen/qwen3.8-27b')
+        self.assertEqual(out['provider'], 'groq')
+        self.assertEqual(out['http_status'], 200)
+        self.assertTrue(out['request_time'])
+        self.assertTrue(out['image_sha256'])
+        self.assertIn('crop.png:', out['image_sha256'])
+        self.assertEqual(len(http.calls), 1)
+        call = http.calls[0]
+        self.assertEqual(call['model'], 'qwen/qwen3.8-27b')
+        self.assertEqual(call['temperature'], 0)
+        self.assertEqual(call['user_agent'], G.DEFAULT_USER_AGENT)
+        self.assertEqual(call['n_images'], 1)
+        self.assertTrue(call['data_uri_prefix'].startswith('data:image/png;base64,'))
+        self.assertEqual(call['authorization_prefix'], 'Bearer')
+        blob = json.dumps(out)
+        self.assertNotIn('test-key-not-real', blob)
+        self.assertNotIn('test-key-not-real', json.dumps(http.calls))
+
+    def test_retries_on_429_then_succeeds(self):
+        body = {'choices': [{'message': {'content': 'ok after retry'}}]}
+        http = FakeHttp([(429, {'error': {'message': 'rate'}}), (200, body)])
+        with mock.patch('ai_vision_groq.time.sleep', return_value=None):
+            out = G.transcribe_item(
+                self.item, [str(self.img)],
+                {'max_retries': 2, 'timeout_seconds': 5},
+                post=http, budget=G.CallBudget(5), key='k')
+        self.assertEqual(out['transcribed_text'], 'ok after retry')
+        self.assertEqual(out['attempts'], 2)
+        self.assertEqual(len(http.calls), 2)
+
+    def test_does_not_retry_unauthorized(self):
+        http = FakeHttp([(401, {'error': {'message': 'no'}})])
+        out = G.transcribe_item(
+            self.item, [str(self.img)],
+            {'max_retries': 3}, post=http, budget=G.CallBudget(5), key='k')
+        self.assertEqual(out['http_status'], 401)
+        self.assertFalse(out['transcribed_text'])
+        self.assertIn('HTTP 401', out['skip_reason'])
+        self.assertEqual(len(http.calls), 1)
+
+    def test_missing_key_does_not_call_http(self):
+        http = FakeHttp([(200, {})])
+        with mock.patch.dict(os.environ, {}, clear=False):
+            os.environ.pop('GROQ_API_KEY', None)
+            out = G.transcribe_item(self.item, [str(self.img)], {}, post=http, budget=G.CallBudget(5))
+        self.assertEqual(out['skip_reason'], 'GROQ_API_KEY is not set')
+        self.assertEqual(http.calls, [])
+
+    def test_call_cap_blocks_after_limit(self):
+        body = {'choices': [{'message': {'content': 'one'}}]}
+        http = FakeHttp([(200, body), (200, body)])
+        budget = G.CallBudget(1)
+        first = G.transcribe_item(self.item, [str(self.img)], {'max_retries': 0}, post=http, budget=budget, key='k')
+        second = G.transcribe_item(self.item, [str(self.img)], {'max_retries': 0}, post=http, budget=budget, key='k')
+        self.assertEqual(first['transcribed_text'], 'one')
+        self.assertEqual(second['skip_reason'], 'AI vision call cap reached')
+        self.assertEqual(len(http.calls), 1)
+        self.assertEqual(budget.used, 1)
+
+    def test_run_provider_dispatches_groq_when_enabled(self):
+        body = {'choices': [{'message': {'content': 'from provider'}}]}
+        http = FakeHttp([(200, body)])
+        cfg = {
+            'ai_vision': {
+                'enabled': True,
+                'provider': 'groq',
+                'model': 'qwen/qwen3.8-27b',
+                'temperature': 0,
+                'max_retries': 0,
+            }
+        }
+        with mock.patch('ai_vision_groq.post_json', http):
+            out = AI.run_provider(self.item, [str(self.img)], cfg, budget=G.CallBudget(5))
+        # run_provider uses env key; patch transcribe to inject key via G.api_key
+        # If GROQ_API_KEY is set in this environment, this would make a mocked post only.
+        # If not set, skip. Force the key for this test by calling with patched env.
+        if out is None or out.get('skip_reason') == 'GROQ_API_KEY is not set':
+            with mock.patch.dict(os.environ, {'GROQ_API_KEY': 'k'}, clear=False):
+                with mock.patch('ai_vision_groq.post_json', http):
+                    out = AI.run_provider(self.item, [str(self.img)], cfg, budget=G.CallBudget(5))
+        self.assertEqual(out['transcribed_text'], 'from provider')
+        self.assertEqual(out['provider'], 'groq')
+
+    def test_run_provider_stays_off_by_default(self):
+        http = FakeHttp([(200, {'choices': [{'message': {'content': 'no'}}]})])
+        with mock.patch.dict(os.environ, {}, clear=False):
+            for name in ('CERTPASSLY_AI_VISION_ENABLED', 'CERTPASSLY_AI_VISION_PROVIDER'):
+                os.environ.pop(name, None)
+            with mock.patch('ai_vision_groq.post_json', http):
+                out = AI.run_provider(self.item, [str(self.img)], {'ai_vision': {}})
+        self.assertIsNone(out)
+        self.assertEqual(http.calls, [])
+
+    def test_report_includes_model_time_hash_not_key(self):
+        rec = AI.build_record(
+            self.item,
+            {
+                'source': 'groq',
+                'provider': 'groq',
+                'model': 'qwen/qwen3.8-27b',
+                'confidence': 0.0,
+                'request_time': '2026-11-21T12:00:00Z',
+                'duration_ms': 120,
+                'image_sha256': 'crop.png:abcd',
+                'transcribed_text': 'hello',
+                'groq_call_index': 1,
+            },
+            {'ok': True, 'reason': 'accepted'},
+        )
+        path = AI.write_report(str(self.dir), 'DEMO', [rec], groq_calls=1)
+        payload = json.loads(Path(path).read_text())
+        self.assertEqual(payload['groq_calls'], 1)
+        item = payload['items'][0]
+        self.assertEqual(item['model'], 'qwen/qwen3.8-27b')
+        self.assertEqual(item['request_time'], '2026-11-21T12:00:00Z')
+        self.assertEqual(item['image_sha256'], 'crop.png:abcd')
+        dumped = Path(path).read_text()
+        self.assertNotIn('GROQ_API_KEY', dumped)
+        self.assertNotIn('Bearer ', dumped)
+
+    def test_multiple_images_one_call(self):
