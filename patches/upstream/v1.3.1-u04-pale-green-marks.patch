+def _color(path):
+    if not path or not os.path.isfile(path):
+        return None
+    return cv2.imread(path, cv2.IMREAD_COLOR)
+
+
+def _greenness(bgr):
+    """Green excess: G minus the larger of R and B, per pixel.
+
+    A pale green fill (the usual correct-answer wash) is almost invisible in
+    grayscale but stands out here: about 29 for the fill, about 0 for white
+    paper and for near-neutral text.
+    """
+    b = bgr[:, :, 0].astype(np.float32)
+    g = bgr[:, :, 1].astype(np.float32)
+    r = bgr[:, :, 2].astype(np.float32)
+    return g - np.maximum(r, b)
+
+
