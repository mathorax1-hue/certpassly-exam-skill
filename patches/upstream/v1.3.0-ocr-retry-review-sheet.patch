diff --git a/scripts/ocr_retry.py b/scripts/ocr_retry.py
new file mode 100644
index 0000000..513bede
--- /dev/null
+++ b/scripts/ocr_retry.py
@@ -0,0 +1,241 @@
+#!/usr/bin/env python3
+"""Retry OCR only for items held for OCR reasons. No AI, no web.
+
+Re-renders the source image or PDF page at a higher resolution, enhances it
+(grayscale, sharpen, contrast, optional binarize), and reruns both fidelity
+OCR passes. The same strict fidelity gate still decides whether the item
+can be exported. Every attempt is logged.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+
+import cv2
+import numpy as np
+
+import ocr_extract as O
+import vision_util as V
+
+OCR_REASON_HINTS = (
+    'ocr words below',
+    'ocr overall confidence',
+    'ocr passes disagree',
+    'ocr word confidence',
+    'ocr min word',
+)
+
+
+def retry_config(cfg=None):
+    cfg = cfg if isinstance(cfg, dict) else (V.load_ocr_config() or {})
+    retry = dict(cfg.get('retry') or {})
+    retry.setdefault('enabled', True)
+    retry.setdefault('dpi', 350)
+    retry.setdefault('scale', 3)
+    retry.setdefault('grayscale', True)
+    retry.setdefault('sharpen', True)
+    retry.setdefault('contrast', 1.5)
+    retry.setdefault('clahe', True)
+    retry.setdefault('brightness', 0)
+    retry.setdefault('binarize', False)
+    retry.setdefault('prefer_pdf_raster', True)
+    retry.setdefault('pdf_enhance_scale', 1)
+    return retry
+
+
+def is_ocr_hold(hold=None, gate=None) -> bool:
+    """True when the hold is about OCR quality, not type or key rules."""
+    parts = []
+    if isinstance(hold, dict):
+        parts.append(str(hold.get('reason') or ''))
+        fid = hold.get('fidelity') if isinstance(hold.get('fidelity'), dict) else {}
+        parts.append(str(fid.get('reason') or ''))
+        gate = gate or fid
+    if isinstance(gate, dict):
+        parts.append(str(gate.get('reason') or ''))
+        if gate.get('ocr_agree') is False:
+            return True
+        try:
+            if gate.get('ocr_min_word_confidence') is not None and float(gate['ocr_min_word_confidence']) < 90:
+                return True
+        except (TypeError, ValueError):
+            pass
+        try:
+            if gate.get('ocr_overall_confidence') is not None and float(gate['ocr_overall_confidence']) < 95:
+                return True
+        except (TypeError, ValueError):
+            pass
+    text = ' '.join(parts).lower()
+    return any(h in text for h in OCR_REASON_HINTS)
+
+
+def file_sha256(path: str) -> str | None:
+    if not path or not os.path.isfile(path):
+        return None
+    h = hashlib.sha256()
+    with open(path, 'rb') as fh:
+        for chunk in iter(lambda: fh.read(1024 * 1024), b''):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def enhance_image(src_path: str, dest_path: str, retry_cfg=None) -> str | None:
+    """Write an enhanced grayscale copy. Returns dest_path or None."""
+    retry_cfg = retry_cfg or {}
+    img = cv2.imread(src_path, cv2.IMREAD_COLOR)
+    if img is None:
+        img = cv2.imread(src_path, cv2.IMREAD_GRAYSCALE)
+        if img is None:
+            return None
+        if img.ndim == 2:
+            img = cv2.cvtColor(img, cv2.COLOR_GRAY2BGR)
+    scale = float(retry_cfg.get('scale') or 3)
+    if scale and abs(scale - 1.0) > 0.01:
+        img = cv2.resize(img, None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC)
+    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY) if (retry_cfg.get('grayscale', True) or img.ndim == 3) else img
+    if gray.ndim == 3:
+        gray = cv2.cvtColor(gray, cv2.COLOR_BGR2GRAY)
+    contrast = float(retry_cfg.get('contrast') or 1.5)
+    brightness = float(retry_cfg.get('brightness') or 0)
+    gray = cv2.convertScaleAbs(gray, alpha=contrast, beta=brightness)
+    if retry_cfg.get('clahe', True):
+        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
+        gray = clahe.apply(gray)
+    if retry_cfg.get('sharpen', True):
+        blur = cv2.GaussianBlur(gray, (0, 0), 1.0)
+        gray = cv2.addWeighted(gray, 1.5, blur, -0.5, 0)
+        gray = np.clip(gray, 0, 255).astype(np.uint8)
+    if retry_cfg.get('binarize'):
+        _, gray = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
+    os.makedirs(os.path.dirname(dest_path) or '.', exist_ok=True)
+    if not cv2.imwrite(dest_path, gray):
+        return None
+    return dest_path
+
+
+def _safe_name(name: str) -> str:
+    base = os.path.basename(name or 'image')
+    return re.sub(r'[^A-Za-z0-9._-]+', '_', base) or 'image.png'
+
+
+def retry_item(item, ocr_item, out_dir, pdf, cfg=None):
+    """Rerun both OCR passes on enhanced images. Returns (new_ocr_item, log)."""
+    cfg = cfg if isinstance(cfg, dict) else (V.load_ocr_config() or {})
+    retry_cfg = retry_config(cfg)
+    key = (item or {}).get('question_key') or 'unknown'
+    media = os.path.join(out_dir, 'media', 'src')
+    dest_dir = os.path.join(out_dir, 'media', 'retry')
+    os.makedirs(dest_dir, exist_ok=True)
+    log = {
+        'question_key': key,
+        'attempted': True,
+        'source_images': [],
+        'retry_images': [],
+        'pdf_raster': [],
+        'outcome': 'still_held',
+        'notes': [],
+    }
+    sources = list((item or {}).get('question_images') or [])
+    sources += [fn for fn in (item or {}).get('answer_images') or [] if fn not in sources]
+    if not sources and retry_cfg.get('prefer_pdf_raster') and pdf and (item or {}).get('pages'):
+        for page in item.get('pages') or []:
+            fn = O.raster_page(pdf, dest_dir, page, retry_cfg.get('dpi') or 350,
+                               prefix='retry-raster-%s' % key)
+            if fn:
+                sources.append(fn)
+                log['pdf_raster'].append({'page': page, 'file': fn, 'dpi': retry_cfg.get('dpi')})
+    enhanced_names = []
+    used_paths = []
+    for fn in sources:
+        src = fn if os.path.isabs(fn) else os.path.join(media, fn)
+        if not os.path.isfile(src):
+            alt = os.path.join(dest_dir, os.path.basename(fn))
+            if os.path.isfile(alt):
+                src = alt
+            else:
+                log['notes'].append('missing image %s' % fn)
+                continue
+        log['source_images'].append(os.path.basename(fn))
+        # High-dpi rasters already in dest_dir should not be scaled again.
+        this_cfg = dict(retry_cfg)
+        if os.path.dirname(os.path.abspath(src)) == os.path.abspath(dest_dir):
+            this_cfg['scale'] = float(retry_cfg.get('pdf_enhance_scale') or 1)
+        dest_name = '%s-%s' % (key, _safe_name(fn))
+        dest = os.path.join(dest_dir, dest_name)
+        written = enhance_image(src, dest, this_cfg)
+        if not written:
+            log['notes'].append('enhance failed for %s' % fn)
+            continue
+        enhanced_names.append(dest_name)
+        used_paths.append(written)
+        log['retry_images'].append({
+            'file': dest_name,
+            'source': os.path.basename(fn),
+            'sha256': file_sha256(written),
+        })
+
+    if not used_paths:
+        log['attempted'] = True
+        log['outcome'] = 'no_retry_image'
+        log['notes'].append('no source image could be enhanced')
+        return ocr_item, log
+
+    # OCR the enhanced images using the same two fidelity passes.
+    images = []
+    confs = []
+    notes = list((ocr_item or {}).get('notes') or [])
+    notes.append('ocr retry on enhanced images')
+    for dest_name, dest_path in zip(enhanced_names, used_paths):
+        rec_img, _lines = O.ocr_image(dest_dir, dest_name, cfg, 'question-retry')
+        rec_img['retry'] = True
+        rec_img['source_file'] = dest_name
+        images.append(rec_img)
+        if rec_img.get('mean_confidence') is not None:
+            confs.append(rec_img['mean_confidence'])
+        if rec_img.get('notes'):
+            notes.extend(rec_img['notes'])
+    mean = round(sum(confs) / len(confs), 1) if confs else None
+    mins = [im.get('min_confidence') for im in images if im.get('min_confidence') is not None]
+    minc = min(mins) if mins else None
+    agree = all(im.get('agree', True) for im in images) if images else True
+    new_ocr = dict(ocr_item or {})
+    new_ocr.update({
+        'question_key': key,
+        'images': images,
+        'confidence': mean,
+        'min_confidence': minc,
+        'notes': notes,
+        'agree': agree,
+        'retry_applied': True,
+    })
+    log['after'] = {
+        'min_confidence': minc,
+        'overall_confidence': mean,
+        'agree': agree,
+        'image_count': len(images),
+    }
+    log['before'] = {
+        'min_confidence': (ocr_item or {}).get('min_confidence'),
+        'overall_confidence': (ocr_item or {}).get('confidence'),
+        'agree': (ocr_item or {}).get('agree'),
+    }
+    return new_ocr, log
+
+
+def write_retry_log(out_dir, rows, exam=None):
+    export_dir = os.path.join(out_dir, 'export')
+    os.makedirs(export_dir, exist_ok=True)
+    payload = {
+        'exam': exam,
+        'attempted': sum(1 for r in rows if r.get('attempted')),
+        'recovered': sum(1 for r in rows if r.get('outcome') == 'recovered'),
+        'still_held': sum(1 for r in rows if r.get('outcome') == 'still_held'),
+        'items': rows,
+    }
+    path = os.path.join(export_dir, 'ocr-retry.json')
+    with open(path, 'w', encoding='utf-8') as fh:
+        json.dump(payload, fh, indent=2, ensure_ascii=False)
+        fh.write('\n')
+    return path
