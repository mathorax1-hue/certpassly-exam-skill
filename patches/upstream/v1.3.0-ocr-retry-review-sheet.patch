+#!/usr/bin/env python3
+"""OCR retry, review sheet, and owner corrections. No AI, no web."""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+SKILL = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(SKILL / 'scripts'))
+
+import ocr_retry
+import owner_corrections as OC
+import review_sheet
+
+
+def _write_gray(path, w=80, h=40, text=True):
+    img = np.full((h, w), 240, dtype=np.uint8)
+    if text:
+        cv2.putText(img, 'AB', (8, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.9, 0, 2, cv2.LINE_AA)
+    cv2.imwrite(str(path), img)
+
+
+class OcrHoldTests(unittest.TestCase):
+    def test_detects_ocr_reasons_only(self):
+        self.assertTrue(ocr_retry.is_ocr_hold(
+            {'reason': 'OCR words below 90: foo (12.0); OCR overall confidence 70.0 is below 95'}))
+        self.assertTrue(ocr_retry.is_ocr_hold(
+            {'reason': 'extra words: x', 'fidelity': {'ocr_agree': False, 'reason': 'OCR passes disagree on: item'}}))
+        self.assertTrue(ocr_retry.is_ocr_hold(None, {'ocr_overall_confidence': 69.6, 'reason': 'OCR overall confidence 69.6 is below 95'}))
+        self.assertFalse(ocr_retry.is_ocr_hold({'reason': 'stem asks for 2 choices but the key has 1'}))
+        self.assertFalse(ocr_retry.is_ocr_hold({'reason': 'no type rule matched'}))
+
+
+class EnhanceTests(unittest.TestCase):
+    def test_enhance_writes_larger_grayscale(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            src = Path(tmp) / 'src.png'
+            dest = Path(tmp) / 'out.png'
+            _write_gray(src, 40, 20)
+            written = ocr_retry.enhance_image(str(src), str(dest), {
+                'scale': 3, 'grayscale': True, 'sharpen': True, 'contrast': 1.5,
+                'clahe': True, 'binarize': False, 'brightness': 0,
+            })
+            self.assertEqual(written, str(dest))
+            img = cv2.imread(str(dest), cv2.IMREAD_UNCHANGED)
+            self.assertIsNotNone(img)
+            self.assertEqual(len(img.shape), 2)
+            self.assertGreaterEqual(img.shape[1], 100)
+            self.assertGreaterEqual(img.shape[0], 50)
+
+
+class ReviewSheetTests(unittest.TestCase):
+    def test_writes_json_md_html_with_empty_owner_fields(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            split = {'q003': {'question_key': 'q003', 'source_text': 'PDF TEXT', 'question_images': ['p-1.png']}}
+            held = [{'question_key': 'q003', 'reason': 'OCR overall confidence 70 is below 95'}]
+            ocr = {'q003': {'images': [{'text': 'OCR TEXT', 'file': 'p-1.png'}]}}
+            result = review_sheet.write_review_sheet(tmp, 'DEMO', split, held, ocr)
+            self.assertEqual(result['held_count'], 1)
+            data = json.loads((Path(tmp) / 'export' / 'review-sheet.json').read_text())
+            row = data['items'][0]
+            self.assertEqual(row['question_key'], 'q003')
+            self.assertEqual(row['pdf_text'], 'PDF TEXT')
+            self.assertEqual(row['ocr_text'], 'OCR TEXT')
+            self.assertEqual(row['hold_reason'], 'OCR overall confidence 70 is below 95')
+            self.assertEqual(row['owner_text'], '')
+            self.assertEqual(row['owner_decision'], '')
+            md = (Path(tmp) / 'export' / 'review-sheet.md').read_text()
+            html = (Path(tmp) / 'export' / 'review-sheet.html').read_text()
+            self.assertIn('q003', md)
+            self.assertIn('owner_text', md)
+            self.assertIn('q003', html)
+
+
+class OwnerCorrectionTests(unittest.TestCase):
+    def test_empty_review_row_is_not_applied(self):
+        self.assertFalse(OC.is_complete({'question_key': 'q003', 'owner_text': '', 'owner_decision': ''}))
+        self.assertFalse(OC.is_complete({'question_key': 'q003', 'stem': 'A stem', 'owner_decision': ''}))
+        self.assertFalse(OC.is_complete({'question_key': 'q003', 'owner_decision': 'use_owner_text', 'stem': ''}))
+        self.assertTrue(OC.is_complete({
+            'question_key': 'q003', 'owner_decision': 'use_owner_text', 'stem': 'Corrected stem',
+        }))
+
+    def test_load_ignores_incomplete_rows(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / 'review' / 'owner-corrections.json'
+            path.parent.mkdir()
+            path.write_text(json.dumps({
+                'schema_version': 1,
+                'exam_code': 'DEMO',
+                'corrections': [
+                    {'question_key': 'q001', 'owner_decision': '', 'stem': ''},
+                    {'question_key': 'q002', 'owner_decision': 'use_owner_text',
+                     'stem': 'Fixed stem', 'options': {'a': 'One', 'b': 'Two'},
+                     'answer_raw': 'A', 'corrected_by': 'Owner', 'corrected_at': '2026-11-21T12:00:00Z'},
+                ],
+            }), encoding='utf-8')
+            loaded = OC.load_corrections(tmp, 'DEMO')
+            self.assertNotIn('q001', loaded)
+            self.assertIn('q002', loaded)
+
+    def test_apply_and_mark_keeps_schema_safe_fields(self):
+        item = {'question_key': 'q002', 'stem': 'Old', 'options': {'a': 'x'}, 'answer_raw': 'B'}
+        corr = {
+            'question_key': 'q002', 'owner_decision': 'use_owner_text',
+            'stem': 'Fixed stem', 'options': {'a': 'One', 'b': 'Two'},
+            'answer_raw': 'A', 'corrected_by': 'Owner', 'corrected_at': '2026-11-21T12:00:00Z',
+        }
+        out = OC.apply_correction(item, corr)
+        self.assertEqual(out['stem'], 'Fixed stem')
+        self.assertEqual(out['options']['a'], 'One')
+        self.assertEqual(out['answer_raw'], 'A')
+        rec = OC.build_record(out, corr, '/tmp', now='2026-11-21T12:00:00Z')
+        q = OC.mark_question({
+            'question_key': 'q002', 'version': 1, 'type': 'single_choice',
+            'domain': 'Unassigned', 'learner': {'stem': 'Fixed stem'},
+            'answer': {'answer_key': {'choice_ids': ['a']}, 'status': 'owner_key',
+                       'scoring_excluded': False, 'reviewer_needed': False},
+        }, rec)
+        self.assertIn('owner_checked', q['tags'])
+        self.assertIn('owner_checked', q['answer']['source'])
+        self.assertIn('by=Owner', q['answer']['source'])
+
+    def test_only_ocr_or_coverage_reasons(self):
+        self.assertTrue(OC.only_ocr_or_coverage_reasons(
+            {'reason': 'OCR overall confidence 70 is below 95; extra words: foo'}))
+        self.assertFalse(OC.only_ocr_or_coverage_reasons(
+            {'reason': 'stem asks for 2 choices but the key has 1'}))
+        self.assertFalse(OC.only_ocr_or_coverage_reasons(
+            {'reason': 'OCR words below 90: x; no type rule matched'}))
+
+
+class ExportRetryHookTests(unittest.TestCase):
+    def test_retry_log_and_review_sheet_from_export_loop(self):
+        # Functional check that a still-held OCR item is retried when possible
+        # and always lands on the review sheet. Uses a missing image so retry
+        # logs no_retry_image, which is deterministic without Tesseract text.
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp)
+            (out / 'extracted').mkdir()
+            (out / 'media' / 'src').mkdir(parents=True)
+            item = {
+                'question_key': 'q001', 'source_number': 1,
+                'stem': 'What is two plus two?',
+                'options': {'a': '3', 'b': '4', 'c': '5', 'd': '6'},
+                'answer_raw': 'B',
+                'source_text': 'What is two plus two?\nA. 3\nB. 4\nC. 5\nD. 6',
+                'question_images': ['missing.png'],
+                'pages': [1],
+            }
+            (out / 'extracted' / 'split.json').write_text(json.dumps({'q001': item}), encoding='utf-8')
+            (out / 'extracted' / 'ocr.json').write_text(json.dumps({
+                'items': {'q001': {
+                    'question_key': 'q001',
+                    'confidence': 40.0,
+                    'min_confidence': 20.0,
+                    'agree': False,
+                    'images': [{'file': 'missing.png', 'text': 'blur', 'mean_confidence': 40.0,
+                                'min_confidence': 20.0, 'agree': False, 'words': [
+                                    {'text': 'blur', 'conf': 20.0}
+                                ]}],
+                    'notes': ['OCR passes disagree'],
+                }}
