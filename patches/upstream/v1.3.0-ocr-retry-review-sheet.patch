+#!/usr/bin/env python3
+"""Write a review sheet for every item that is still held. No AI, no auto-fill."""
+from __future__ import annotations
+
+import html
+import json
+import os
+
+
+def _ocr_text(ocr_item) -> str:
+    if not isinstance(ocr_item, dict):
+        return ''
+    parts = []
+    for im in ocr_item.get('images') or []:
+        if not isinstance(im, dict):
+            continue
+        t = (im.get('text') or '').strip()
+        if t:
+            parts.append(t)
+    if not parts and (ocr_item.get('text') or '').strip():
+        parts.append(ocr_item['text'].strip())
+    return '\n'.join(parts)
+
+
+def _image_paths(item, ocr_item, out_dir) -> list[str]:
+    names = []
+    for rec in (item or {}).get('question_images') or []:
+        names.append(rec)
+    for rec in (item or {}).get('answer_images') or []:
+        if rec not in names:
+            names.append(rec)
+    for im in (ocr_item or {}).get('images') or []:
+        fn = (im or {}).get('file') if isinstance(im, dict) else None
+        if fn and fn not in names:
+            names.append(fn)
+    paths = []
+    for name in names:
+        rel = os.path.join('media', 'src', os.path.basename(name))
+        abs_path = os.path.join(out_dir, rel)
+        if not os.path.isfile(abs_path):
+            for folder in (os.path.join('media', 'retry'), os.path.join('media', 'src')):
+                cand = os.path.join(out_dir, folder, os.path.basename(name))
+                if os.path.isfile(cand):
+                    rel = os.path.join(folder, os.path.basename(name))
+                    break
+        paths.append(rel.replace('\\', '/'))
+    return paths
+
+
+def build_rows(exam, split, held, ocr_items, out_dir) -> list[dict]:
+    rows = []
+    for hold in held or []:
+        key = hold.get('question_key') if isinstance(hold, dict) else None
+        if not key:
+            continue
+        item = (split or {}).get(key) or {}
+        ocr_item = (ocr_items or {}).get(key) or {}
+        fid = hold.get('fidelity') if isinstance(hold.get('fidelity'), dict) else {}
+        reason = hold.get('reason') or fid.get('reason') or ''
+        rows.append({
+            'exam_code': exam,
+            'question_key': key,
+            'image_paths': _image_paths(item, ocr_item, out_dir),
+            'ocr_text': _ocr_text(ocr_item),
+            'pdf_text': item.get('source_text') or '',
+            'hold_reason': reason,
+            'owner_text': '',
+            'owner_decision': '',
+        })
+    return rows
+
+
+def _write_markdown(exam, rows) -> str:
+    lines = [
+        '# Review sheet: %s' % exam,
+        '',
+        'Held items that still need an owner decision. owner_text and owner_decision are left empty.',
+        'Copy a row into exams/%s/review/owner-corrections.json to apply a correction on the next run.' % exam,
+        '',
+        'Held: %s' % len(rows),
+        '',
+    ]
+    for row in rows:
+        lines.extend([
+            '## %s' % row['question_key'],
+            '',
+            '- Images: %s' % (', '.join(row['image_paths']) or '(none)'),
+            '- Hold reason: %s' % (row['hold_reason'] or '(none)'),
+            '- owner_text:',
+            '- owner_decision:',
+            '',
+            '### PDF text',
+            '',
+            '```',
+            row['pdf_text'] or '',
+            '```',
+            '',
+            '### OCR text',
+            '',
+            '```',
+            row['ocr_text'] or '',
+            '```',
+            '',
+        ])
+    return '\n'.join(lines) + '\n'
+
+
+def _write_html(exam, rows) -> str:
+    parts = [
+        '<!DOCTYPE html>',
+        '<html lang="en"><head><meta charset="utf-8">',
+        '<title>Review sheet: %s</title>' % html.escape(exam or ''),
+        '<style>body{font-family:sans-serif;max-width:900px;margin:1rem auto;line-height:1.4}'
+        'pre{white-space:pre-wrap;background:#f6f6f6;padding:0.75rem}'
+        'h2{margin-top:2rem}</style></head><body>',
+        '<h1>Review sheet: %s</h1>' % html.escape(exam or ''),
+        '<p>Held items that still need an owner decision. '
+        '<code>owner_text</code> and <code>owner_decision</code> are left empty. '
+        'Copy a row into <code>exams/%s/review/owner-corrections.json</code> '
+        'to apply a correction on the next run.</p>' % html.escape(exam or ''),
+        '<p>Held: %s</p>' % len(rows),
+    ]
+    for row in rows:
+        parts.append('<h2>%s</h2>' % html.escape(row['question_key']))
+        parts.append('<ul>')
+        parts.append('<li>Images: %s</li>' % html.escape(', '.join(row['image_paths']) or '(none)'))
+        parts.append('<li>Hold reason: %s</li>' % html.escape(row['hold_reason'] or '(none)'))
+        parts.append('<li>owner_text:</li>')
+        parts.append('<li>owner_decision:</li>')
+        parts.append('</ul>')
+        parts.append('<h3>PDF text</h3><pre>%s</pre>' % html.escape(row['pdf_text'] or ''))
+        parts.append('<h3>OCR text</h3><pre>%s</pre>' % html.escape(row['ocr_text'] or ''))
+    parts.append('</body></html>\n')
+    return '\n'.join(parts)
+
+
+def write_review_sheet(out_dir, exam, split, held, ocr_items) -> dict:
+    export_dir = os.path.join(out_dir, 'export')
+    os.makedirs(export_dir, exist_ok=True)
+    rows = build_rows(exam, split, held, ocr_items, out_dir)
+    payload = {
+        'schema_version': 1,
+        'exam_code': exam,
+        'held_count': len(rows),
+        'items': rows,
+        'note': 'owner_text and owner_decision are left empty. Do not auto-fill them.',
+    }
+    paths = {}
+    jp = os.path.join(export_dir, 'review-sheet.json')
+    with open(jp, 'w', encoding='utf-8') as fh:
+        json.dump(payload, fh, indent=2, ensure_ascii=False)
+        fh.write('\n')
+    paths['json'] = jp
+    mp = os.path.join(export_dir, 'review-sheet.md')
+    with open(mp, 'w', encoding='utf-8') as fh:
+        fh.write(_write_markdown(exam, rows))
+    paths['markdown'] = mp
+    hp = os.path.join(export_dir, 'review-sheet.html')
+    with open(hp, 'w', encoding='utf-8') as fh:
+        fh.write(_write_html(exam, rows))
+    paths['html'] = hp
+    return {'held_count': len(rows), 'paths': paths}
