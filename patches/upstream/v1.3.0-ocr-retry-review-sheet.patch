@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Load committed owner corrections. Never auto-fill empty fields."""
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime, timezone
+
+from ocr_retry import file_sha256
+
+
+def _load(path):
+    if not path or not os.path.isfile(path):
+        return None
+    with open(path, encoding='utf-8') as fh:
+        return json.load(fh)
+
+
+def find_corrections_path(root, exam, explicit=None):
+    candidates = []
+    if explicit:
+        candidates.append(explicit)
+    if root:
+        candidates.extend([
+            os.path.join(root, 'review', 'owner-corrections.json'),
+            os.path.join(root, 'exams', exam or '', 'review', 'owner-corrections.json'),
+        ])
+    for path in candidates:
+        if path and os.path.isfile(path):
+            return path
+    return None
+
+
+def load_corrections(root, exam, explicit=None) -> dict:
+    """Return {question_key: correction_dict} for complete, non-empty corrections only."""
+    path = find_corrections_path(root, exam, explicit)
+    data = _load(path) if path else None
+    out = {}
+    if not isinstance(data, dict):
+        return out
+    rows = data.get('corrections') or data.get('items') or []
+    if not isinstance(rows, list):
+        return out
+    for row in rows:
+        if not isinstance(row, dict):
+            continue
+        key = row.get('question_key') or row.get('id')
+        if not key or not is_complete(row):
+            continue
+        rec = dict(row)
+        rec['_source_path'] = path
+        out[str(key)] = rec
+    return out
+
+
+def is_complete(row) -> bool:
+    """A correction is used only when the owner filled a decision and the learner text."""
+    if not isinstance(row, dict):
+        return False
+    decision = str(row.get('owner_decision') or '').strip()
+    stem = str(row.get('stem') or '').strip()
+    # Never treat an empty review-sheet row as a correction.
+    if not decision or not stem:
+        return False
+    return True
+
+
+def apply_correction(item, correction) -> dict:
+    """Return a copy of the item with owner-provided stem/options/key. Empty fields stay."""
+    out = dict(item or {})
+    stem = str(correction.get('stem') or '').strip()
+    if stem:
+        out['stem'] = stem
+        out.pop('image_only', None)
+    options = correction.get('options')
+    if isinstance(options, dict) and any(str(v or '').strip() for v in options.values()):
+        out['options'] = {str(k).lower(): v for k, v in options.items() if str(v or '').strip()}
+    answer_raw = str(correction.get('answer_raw') or correction.get('key') or '').strip()
+    if answer_raw:
+        out['answer_raw'] = answer_raw
+    out['_owner_correction'] = {
+        'question_key': correction.get('question_key'),
+        'owner_decision': correction.get('owner_decision'),
+        'corrected_by': correction.get('corrected_by') or '',
+        'corrected_at': correction.get('corrected_at') or '',
+        'image_sha256': correction.get('image_sha256') or '',
+        'source_path': correction.get('_source_path') or '',
+    }
+    return out
+
+
+def only_ocr_or_coverage_reasons(hold=None, gate=None) -> bool:
+    """True when a built question is held only for OCR quality or word coverage."""
+    texts = []
+    if isinstance(gate, dict) and gate.get('reason'):
+        texts.append(gate['reason'])
+    elif isinstance(hold, dict):
+        texts.append(str(hold.get('reason') or ''))
+        fid = hold.get('fidelity') if isinstance(hold.get('fidelity'), dict) else {}
+        texts.append(str(fid.get('reason') or ''))
+    blob = '; '.join(t for t in texts if t)
+    if not blob.strip():
+        return False
+    parts = [p.strip() for p in blob.split(';') if p.strip()]
+    allowed = (
+        'ocr words below',
+        'ocr overall confidence',
+        'ocr passes disagree',
+        'ocr word confidence',
+        'missing words:',
+        'extra words:',
+    )
+    if not parts:
+        return False
+    for part in parts:
+        low = part.lower()
+        if not any(low.startswith(a) or a in low for a in allowed):
+            return False
+    return True
+
+
+def image_sha_for_item(item, out_dir) -> str:
+    names = list((item or {}).get('question_images') or []) + list((item or {}).get('answer_images') or [])
+    shas = []
+    for name in names:
+        for folder in (os.path.join('media', 'src'), os.path.join('media', 'retry')):
+            path = os.path.join(out_dir, folder, os.path.basename(name))
+            digest = file_sha256(path)
+            if digest:
+                shas.append('%s:%s' % (os.path.basename(name), digest))
+                break
+    return '; '.join(shas)
+
+
+def build_record(item, correction, out_dir, now=None) -> dict:
+    now = now or datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
+    provided_sha = str(correction.get('image_sha256') or '').strip()
+    computed = image_sha_for_item(item, out_dir)
+    return {
+        'question_key': item.get('question_key'),
+        'owner_checked': True,
+        'owner_decision': correction.get('owner_decision') or '',
+        'corrected_by': correction.get('corrected_by') or '',
+        'corrected_at': correction.get('corrected_at') or now,
+        'recorded_at': now,
+        'image_sha256': provided_sha or computed,
+        'computed_image_sha256': computed,
+    }
+
+
+def mark_question(question, record):
+    """Attach schema-safe owner_checked marks (tags + answer.source)."""
+    q = dict(question or {})
+    tags = list(q.get('tags') or [])
+    if 'owner_checked' not in tags:
+        tags.append('owner_checked')
+    q['tags'] = tags
+    answer = dict(q.get('answer') or {})
+    bits = ['owner_checked']
+    if record.get('corrected_by'):
+        bits.append('by=%s' % record['corrected_by'])
+    if record.get('corrected_at'):
+        bits.append('at=%s' % record['corrected_at'])
+    if record.get('image_sha256'):
+        bits.append('image_sha256=%s' % record['image_sha256'])
+    source = '; '.join(bits)
+    existing = str(answer.get('source') or '').strip()
+    answer['source'] = (existing + '; ' + source).strip('; ') if existing else source
+    q['answer'] = answer
+    return q
+
+
+def write_records(out_dir, exam, records):
+    export_dir = os.path.join(out_dir, 'export')
+    os.makedirs(export_dir, exist_ok=True)
+    path = os.path.join(export_dir, 'owner-checked.json')
+    with open(path, 'w', encoding='utf-8') as fh:
+        json.dump({'exam': exam, 'count': len(records), 'items': records}, fh, indent=2, ensure_ascii=False)
+        fh.write('\n')
+    return path
