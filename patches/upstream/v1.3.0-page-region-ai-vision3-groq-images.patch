+def _page_region_crop(pr_dir, key, base, safe):
+    """Return the 400 dpi crop-* file for this image when it exists."""
+    if not pr_dir or not os.path.isdir(pr_dir):
+        return None
+    suffixes = []
+    for part in (base, safe):
+        if part and part not in suffixes:
+            suffixes.append(part)
+    # Also match when the stored name already includes the question key.
+    if key and base.startswith('%s-' % key):
+        rest = base[len(key) + 1:]
+        if rest and rest not in suffixes:
+            suffixes.append(rest)
+    hits = []
+    try:
+        names = os.listdir(pr_dir)
+    except OSError:
+        return None
+    for name in names:
+        if not name.startswith('crop-') or not name.lower().endswith(('.png', '.jpg', '.jpeg')):
+            continue
+        if key and ('-%s-' % key) not in ('-' + name) and not name.startswith('crop-%s-' % key) and key not in name:
+            # still allow suffix-only matches below
+            pass
+        for suf in suffixes:
+            if name.endswith(suf) or name.endswith('-' + suf):
+                hits.append(name)
+                break
+    if not hits:
+        return None
+    # Prefer a crop that also contains the question key when several match.
+    hits.sort(key=lambda n: (0 if key and key in n else 1, n))
+    return os.path.join(pr_dir, hits[0])
+
