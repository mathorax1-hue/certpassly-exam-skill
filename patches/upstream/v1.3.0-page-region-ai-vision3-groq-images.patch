+def stitch_images(image_paths, dest):
+    """Stack images top to bottom with a short white gap. Returns dest or None."""
+    import cv2
+    import numpy as np
+    loaded = []
+    for path in image_paths or []:
+        if not path or not os.path.isfile(path):
+            continue
+        img = cv2.imread(str(path), cv2.IMREAD_COLOR)
+        if img is None or img.size == 0:
+            continue
+        loaded.append(img)
+    if not loaded:
+        return None
+    if len(loaded) == 1:
+        ok = cv2.imwrite(dest, loaded[0])
+        return dest if ok and os.path.isfile(dest) else None
+    width = max(im.shape[1] for im in loaded)
+    gap = 16
+    parts = []
+    for i, im in enumerate(loaded):
+        if im.shape[1] != width:
+            pad = np.full((im.shape[0], width - im.shape[1], 3), 255, dtype=im.dtype)
+            im = np.hstack([im, pad])
+        parts.append(im)
+        if i < len(loaded) - 1:
+            parts.append(np.full((gap, width, 3), 255, dtype=im.dtype))
+    stacked = np.vstack(parts)
+    os.makedirs(os.path.dirname(dest) or '.', exist_ok=True)
+    ok = cv2.imwrite(dest, stacked)
+    return dest if ok and os.path.isfile(dest) else None
+
+
+def prepare_image_paths(image_paths, max_images=MAX_IMAGES_PER_REQUEST, work_dir=None):
+    """Return a list of at most max_images paths, stitching when needed."""
+    paths = [p for p in (image_paths or []) if p and os.path.isfile(p)]
+    if len(paths) <= max_images:
+        return paths, False
+    dest_dir = work_dir or tempfile_dir()
+    dest = os.path.join(dest_dir, 'groq-stitched.png')
+    stitched = stitch_images(paths, dest)
+    if stitched:
+        return [stitched], True
+    return paths[:max_images], False
+
+
+def tempfile_dir():
+    import tempfile
+    return tempfile.mkdtemp(prefix='certpassly-groq-')
+
